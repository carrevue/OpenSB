<link href="https://unpkg.com/plyr@3.8.3/dist/plyr.css" rel="stylesheet">
<script src="https://unpkg.com/plyr@3.8.3/dist/plyr.min.js"></script>
{% set video = "/dynamic/videos/" ~ upload.id ~ ".converted.mp4" %}

{% if current_skin == "finalium" and current_theme == "hitchhiker" %}
    {% set simulate_youtube_player = true %}
{% endif %}

{% if current_skin == "trinium" %}
    {% set color = 'var(--link-color)' %}
{% elseif simulate_youtube_player %}
    {% set color = '#ff0000' %}
{% else %}
    {% set color = '#1d89dc' %}
{% endif %}

{% if upload.flags.unprocessed %}
    <style>
        .unprocessed-video-upload {
            background-color: black;
            color: white;
            aspect-ratio: 16 / 9;
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
        }
    </style>
    <div class="unprocessed-video-upload">
        This video is being processed. Try again later.
    </div>
{% else %}
    <style>
        .plyr--video {
            aspect-ratio: 16 / 9;
            --plyr-color-main: {{ color }};
            --plyr-control-spacing: 10px;
        {% if simulate_youtube_player %}
            --plyr-range-thumb-background: {{ color }};
        {% endif %}
        }

        .plyr--video .plyr__controls {
            padding: 32px 4px 2px 4px;
        }

        .plyr--video .plyr__control.plyr__tab-focus,
        .plyr--video .plyr__control:hover,
        .plyr--video .plyr__control[aria-expanded="true"] {
            background: rgba(255, 255, 255, 0.1);
            color: var(--plyr-video-control-color-hover, #fff);
        }

        .plyr__control--overlaid {
            /* hacky because rgba doesnt work with hex variables */
            background: color-mix(in srgb, var(--plyr-color-main) 75%, transparent) !important;
        }

        .plyr__control--overlaid:hover {
            background: var(--plyr-color-main) !important;
        }

        .plyr__menu__container .plyr__control[role="menuitemradio"]::before,
        .plyr__menu__container .plyr__control[role="menuitemradio"]::after {
            display: none;
        }

        .plyr__tooltip {
            background: rgba(24, 24, 24, 0.9);
            color: var(--plyr-tooltip-color, #fff);
        }

        .plyr__tooltip::before {
            border-top: rgba(24, 24, 24, 0.9);
        }

        .plyr__menu__container {
            background: rgba(24, 24, 24, 0.9);
        }

        .plyr__menu__container::after {
            border-top: rgba(24, 24, 24, 0.9);
        }

        .plyr__menu__container .plyr__control {
            color: white;
        }
    </style>
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const video = document.querySelector("video");

            const player = new Plyr(video);

            player.source = {
                type: 'video',
                title: '{{ upload.title }}',
                sources: [
                    {
                        src: '{{ video }}',
                        type: 'video/mp4',
                        size: 720,
                    },
                ],
                poster: '{{ thumbnail(upload.id, upload.type, upload.flags.custom_thumbnail) }}',
                previewThumbnails: {
                    enabled: true,
                    src: '/assets/thumbnails_sample.vtt',
                },
                tracks: [
                    {
                        kind: 'captions',
                        label: 'English (TEST)',
                        srclang: 'en',
                        src: '/assets/captions_sample.vtt',
                        default: true,
                    },
                ],
                markers: {
                    enabled: true,
                    points: [
                        {
                            time: 5,
                            label: "Marker!",
                        },
                        {
                            time: 10,
                            label: "Marker 2!",
                        },
                    ],
                },
            };
        });
    </script>
    <div style="width:100%;">
        <video controls crossorigin playsinline></video>
    </div>
{% endif %}
