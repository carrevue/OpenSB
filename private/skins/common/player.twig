{% set video = "/dynamic/videos/" ~ upload.id ~ ".converted.mp4" %}

{% if upload.flags.unprocessed %}
    <style name="unprocessed-upload">
        .unprocessed-video-upload {
            background-color: black;
            color: white;
            aspect-ratio: 16 / 9;
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
        }
    </style>
    <div class="unprocessed-video-upload">
        This video is being processed. Try again later.
    </div>
{% else %}
    <script name="player-config">
        playerConfig = {
            "url": "{{ video }}",
        };
    </script>
    <script name="player" src="/assets/player.js"></script>
    <style name="dumb-bullshit-no-one-cares-about">
        #video-wrapper {
            width: 100%;
            aspect-ratio: 16 / 9;
            background: black;
            overflow: hidden;
        }

        #video-wrapper video {
            width: 100%;
            height: 100%;
            object-fit: contain;
            display: block;
        }
    </style>
    <div id="video-wrapper"></div>
{% endif %}
