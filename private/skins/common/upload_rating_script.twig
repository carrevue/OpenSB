<script src="/assets/rater.js"></script>
<script>
    var starRating = raterJs( {
        max:5,
        starSize:16,
        rating:{{ upload.interactions.ratings.average }},
        element:document.querySelector("#rater"),
        rateCallback:function rateCallback(rating, done) {
            fetch("/api/skin/upload_interaction", {
                method: "POST",
                body: JSON.stringify({
                    action: "rate",
                    number: rating,
                    upload: upload_int_id,
                }),
                headers: {
                    "Content-type": "application/json; charset=UTF-8"
                }
            }).then((response) => response.json()).then((json) => { if(json["error"]) { error(json["error"])}})
            this.setRating(rating);
            done();
        }
    });
    {% if not logged_in %}
    starRating.disable();
    {% endif %}
</script>
{% if current_skin == "trinium" %}
<style>
    .star-rating {
        mask: url(#stars-mask);
        background: var(--secondary);
    }
     .star-rating .star-value{
        mask: url(#stars-mask);
        background: var(--warning);
     }
</style>
{% endif %}