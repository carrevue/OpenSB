{% extends "_layout.twig" %}

{% set title = localize('members') %}

	{% block content %}
		{% set total_pages = (users.count / items_per_page) | round(0, 'ceil') %}
		{% set current_page = page %}

		<div class="section">
			<div class="section-header flex">
				<div class="section-header-left">
					<h1 class="section-title">{{ title }}</h1>
					<div class="section-desc">{{ localize('page_num_of_num', current_page, total_pages )}}</div>
				</div>
			</div>
			<div class="tabs">
                {% for key, tab in tabs %}
                    <a class="tablink {% if type==key %}active{% endif %}" href="/members?type={{key}}">
                        {{ localize(tab.name) }}
                    </a>                
                {% endfor %}
                {# TODO #}
                <div class="tablink has-icon {% if display=='list' %}active{% endif %}" id="members-list-button">
                    {{ icon('homepage-list', 24) }}
                </div>
                <div class="tablink has-icon {% if display=='grid' %}active{% endif %}" id="members-grid-button">
                    {{ icon('homepage-grid', 24) }}
                </div>
			</div>
			<div class="content-box content-grid content-grid-users no-border-top">
				{% for user in users.users %}
					<div class="content-entry user-id-{{ user.id }}">
						<div class="content-thumbnail">
							<a href="/user/{{ user.info.username }}">
								<div class="content-image profile-picture">
									<img src="{{ profile_picture(user.id) }}"
										 alt="{{ user.info.username }}" class="pfp">
								</div>
							</a>
						</div>
						<div class="content-info">
							<div class="content-title">
								{{ user_link(user) }}
							</div>
                            <div class="content-detail">{{ localize('followers', user.followers) }}</div>
                            <div class="content-detail">{{ localize('upload_count', user.uploads) }}</div>
						</div>
					</div>
				{% endfor %}
			</div>
		</div>

        {% if type == 'recent' %}
            {% set le_url = 'members?page=%s' %}
        {% else %}
            {% set le_url = 'members?type=' ~ type ~ '&page=%s' %}
        {% endif %}

		{{ pagination(users.count, items_per_page, le_url, current_page) }}
	{% endblock %}