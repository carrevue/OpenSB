{% extends "_layout.twig" %}

{% set title = localize('journals') %}

{% if user == "news" %}
{% set title = localize('site_news') %}
{% endif %}

{% block content %}
    {% set total_pages = (count / items_per_page) | round(0, 'ceil') %}
    {% set current_page = page %}

    <div class="section">
        {% if user == "news" %}
            <div class="section-header flex">
                <div class="section-header-left">
                    <h2 class="section-title">{{ title }}</h2>
                    <div class="section-desc">{{ localize('site_news_desc') }}</div>
                </div>
                {#<div class="section-header-right">
                    <a href="/journals/news">{{ localize('more') }}</a>
                </div>#}
            </div>
        {% else %}
            <div class="section-header">
                <h1 class="section-title">{{ title }}</h1>
            </div>
        {% endif %}
        <div class="content-box">
            {% for journal in data %}
                {{ include('/components/_post.twig') }}
            {% else %}
                <p>{{ localize('no_journals') }}</p>
            {% endfor %}
        </div>
    </div>

    {% set le_url = '/journals/' ~ user ~ '?page=%s' %}

    {{ pagination(count, items_per_page, le_url, current_page) }}
{% endblock %}