{% extends "_layout.twig" %}

{% set user_role_titles = {
    4: localize('user_role_owner'),
    3: localize('user_role_administrator'),
    2: localize('user_role_moderator'),
} %}

{% set title = localize('about') %}

{% block content %}
    <div class="section">
        <div class="section-header">
            <h1 class="section-title">{{ localize('about_site', website_branding.name) }}</h1>
        </div>
        <div class="grid">
            <div class="col-8">
                <div class="section">
                    <div class="content-box">
                        <img src="/assets/opensb_logo.svg" class="img-version">
                        <p>{{ localize('version_intro', '2021-' ~ ('now' | date('Y')), data.developers|join(', ')) }}</p>
                        <p>{{ localize('version_agpl') }}</p>
                        <p>{{ localize('version_no_warranty') }}</p>
                        <p>{{ localize('version_license_notice', '/license', 'http://www.gnu.org/licenses/') | raw }}</p>
                        <p>{{ localize('version_github', 'https://github.com/bluffingo/OpenSB') | raw }}</p>
                        <hr>
                        <ul class="unstyled-list">
                            {% for thing in data.software %}
                                <li>
                                    {{ thing.title }}: {{ thing.info }}
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                </div>
            </div>
            <div class="col-4">
                <div class="section">
                    <div class="content-box">
                        {% for user in data.staff %}
                            <div class="content-entry centered index-user user-id-{{ user.id }}">
                                <div class="content-thumbnail">
                                    <a href="/user/{{ user.info.username }}">
                                        <div class="content-image profile-picture">
                                            <img src="{{ profile_picture(user.id) }}"
                                                alt="{{ user.info.username }}" class="pfp">
                                        </div>
                                    </a>
                                </div>
                                <div class="content-info">
                                    <div class="content-author">
                                        {{ user_link(user) }}
                                    </div>
                                    <div class="content-description">
                                        {{ user_role_titles[user.level] }}
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
