{% extends "_layout_profile.twig" %}

{% set banner_picture = profile_banner(data.id) %}

{% set title = data.username %}

{% set opengraph_type = "profile" %}
{% set opengraph_username = data.username %}
{% if data.about | trim is not empty %}
    {% set opengraph_description = data.about %}
{% else %}
    {% set opengraph_description = localize('profile_no_description') %}
{% endif %}
{% set opengraph_image = profile_picture(data.id) %}

{% block scripts %}
    <script>
        comment_type = 'profile';
        comment_id = '{{ data.id }}'
        user_id = '{{ data.id }}'
    </script>
{% endblock %}

{% block precontentappend %}
    {% if data.is_current and enable_incomplete_features %}
    <div class="profile-edit-container">
        <div class="profile-edit">
            <div class="button secondary">Settings</div>
            <div class="button secondary">Themes</div>
            <div class="button secondary">Modules</div>
            <div class="text-danger">Subject to change</div>
        </div>
    </div>
    {% endif %}
{% endblock %}

{% if enable_incomplete_features %}
{% set posts_title = localize('posts') %}
{% else %}
{% set posts_title = localize('journals') %}
{% endif %}

{% block content %}
    {% if data.ban_data %}
        <div class="banner secondary">
            This user was banned on {{ data.ban_data.timestamp | format_date('long', 'medium') }} for the following reason:
            {{ data.ban_data.reason }}
        </div>
    {% endif %}
    <div class="grid">
        <div class="col-4">
            <div class="section">
                <div class="content-box highlight-box no-border-bottom-rounded">
                    <div class="section-header flex">
                        <div class="section-header-left">
                            <h2 class="section-title">{{ data.displayname }}</h2>
                        </div>
                        <div class="section-header-right">
                            {% if not data.ban_data %}
                                {% if is_user_logged_in %}
                                    {% if not data.is_current %}
                                        <button class="button secondary small" id="follow-user">
                                            {% if data.following %}
                                                {{ localize('unfollow') }}
                                            {% else %}
                                                {{ localize('follow') }}
                                            {% endif %}
                                        </button>
                                    {% else %}
                                        <a href="/settings">
                                            {{ localize('edit') }}
                                        </a>
                                    {% endif %}
                                {% endif %}
                            {% endif %}
                        </div>
                    </div>
                    <div class="profile-box">
                        <div class="profile-box-pfp">
                            <div class="profile-picture">
                                <img src="{{ profile_picture(data.id) }}" class="pfp" alt="{{ data.username }}">
                            </div>
                        </div>
                        <div class="profile-box-info">
                            <div class="profile-box-username">
                                <span>@{{ data.username }}</span>
                                {% if data.is_staff %}
                                    <span class="profile-box-icon use-tooltip" title="{{ localize('staff') }}">{{ icon('staff') }}</span>
                                {% endif %}
                            </div>
                            <div class="profile-box-details">
                                <span id="follower_count">{{ data.followers }}</span> followers
                            </div>
                        </div>
                        <div class="profile-box-follow">
                        </div>
                    </div>
                </div>
                <div class="content-box highlight-box no-border-top">
                    {% if data.about | trim is not empty %}
                        <div class="profile-about">
                            {{ data.about | markdown_user_written }}
                            <hr>
                        </div>
                    {% endif %}
                    <div class="profile-details">
                        <ul class="profile-details-list">
                            <li class="detail-item">
                                <span class="detail-label">{{ localize('registered') }}:</span>
                                <span class="detail-value">{{ data.joined | format_date('long', 'none') }}</span>
                            </li>
                            <li class="detail-item">
                                <span class="detail-label">{{ localize('last_seen') }}:</span>
                                <span class="detail-value use-tooltip" title="{{ data.joined | format_date('long', 'none') }}">{{ data.connected | relative_time() }}</span>
                            </li>
                            <li class="detail-item">
                                <span class="detail-label">{{ localize('upload_views') }}:</span>
                                <span class="detail-value">{{ data.views | format_number }}</span>
                            </li>
                        </ul>
                        {% if user_is_authenticated_admin %}
                            <hr>
                            <a href="/dashboard/users/{{ data.username }}">{{ localize('dashboard_lookup') }}</a>
                        {% endif %}
                    </div>
                </div>
            </div>

            <div class="section">
            </div>
        </div>
        <div class="col-8">
             <div class="section">
                <div class="tab-group">
                    <div class="tabs">
                        {# spaceless removes html whitespace that causes unnecessary margins #}
                        {% apply spaceless %}
                            {% if data.uploads %}<div class="tablink" data-tab="tab_feed">{{ localize('uploads') }}</div>{% endif %}
                            {% if data.journals %}<div class="tablink" data-tab="tab_posts">{{ posts_title }}</div>{% endif %}
                            <div class="tablink" data-tab="tab_comments">{{ localize('comments') }} (legacy)</div>
                        {% endapply %}
                    </div>
                    <div class="content-box basic-box no-border-top">
                        {% if data.uploads %}
                        <div id="tab_feed" class="tabcontent">
                            {% if data.featured_upload %}
                                <div class="section-header">
                                    <h2 class="section-title">{{ localize('profile_featured') }}</h2>
                                </div>
                                {% include('/components/_upload_vertical.twig') with {'upload': data.featured_upload} %}
                                <div class="section-header flex">
                                    <div class="section-header-left">
                                        <h2 class="section-title">{{ localize('uploads') }}</h2>
                                    </div>
                                    <div class="section-header-right">
                                        <a href="/user/{{ data.username }}/uploads">{{ localize('more') }}</a>
                                    </div>
                                </div>
                            {% endif %}
                            <div class="content-grid">
                                {% for upload in data.uploads %}
                                    {{ include('/components/_upload_grid.twig') }}
                                {% endfor %}
                            </div>
                            <hr>
                            <div class="section-header">
                                <h2 class="section-title">Collections</h2>
                            </div>
                            <div>
                                PLACEHOLDER
                            </div>
                        </div>
                        {% endif %}
                        {% if data.journals %}
                        <div id="tab_posts" class="tabcontent">
                            <div class="section-header flex">
                                <div class="section-header-left">
                                    <h2 class="section-title">{{ posts_title }}</h2>
                                </div>
                                <div class="section-header-right">
                                    <a href="/user/{{ data.username }}/journals">{{ localize('more') }}</a>
                                </div>
                            </div>
                            {% for journal in data.journals %}
                                {{ include('/components/_post.twig') }}
                            {% endfor %}
                        </div>
                        {% endif %}
                        <div id="tab_comments" class="tabcontent">
                            <div class="section-header flex">
                                <div class="section-header-left">
                                    <h2 class="section-title">{{ localize('comments') }}</h2>
                                </div>
                                <div class="section-header-right">
                                    <a href="/user/{{ data.username }}/comments">
                                        {{ localize('more') }}
                                    </a>
                                </div>
                            </div>
                            {{ include('/components/_comment_input.twig') }}
                            {% for comment in data.comments %}
                                {{ include('/components/_comment.twig') }}
                            {% endfor %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}