{% extends "_layout_profile.twig" %}

{% set title = common.username %}

{% block scripts %}
    <script>
        comment_type = 'profile';
        comment_id = '{{ common.id }}'
        user_id = '{{ common.id }}'
    </script>
{% endblock %}

{% block precontentappend %}
    {% if common.is_current %}
        {#<div class="subheader-container">
            <div class="subheader" id="profile-edit-toolbar">
                <div class="button toolbar">Settings</div>
                <div class="button toolbar">Colors</div>
                <div class="text-danger">Subject to change</div>
            </div>
        </div>#}
        <div class="profile-edit-container" style="">
            <div class="profile-edit">
                <div class="tab-group">
                    <div class="tabs">
                        {# spaceless removes html whitespace that causes unnecessary margins #}
                        {% apply spaceless %}
                            <div class="tablink" data-tab="tab_pfedit_settings">Settings</div>
                            <div class="tablink" data-tab="tab_pfedit_colors">Colors</div>
                        {% endapply %}
                    </div>
                    <div class="content-box no-border-top">
                        <div id="tab_pfedit_settings" class="tabcontent">
                            <div>URL: <a href="{{ page_url }}">{{ page_url }}</a></div>
                        </div>
                        <div id="tab_pfedit_colors" class="tabcontent">
                            <div class="banner secondary">Not implemented!</div>
                        </div>
                        <div class="button accent">Save</div>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}
{% endblock %}

{% block content %}
    {% if common.customization %}
        {% include 'profile_layout/yt2008/overview.twig' %}
    {% else %}
        {% include 'profile_layout/default/overview.twig' %}
    {% endif %}
{% endblock %}