{% extends "_layout_profile.twig" %}

{% set banner_picture = profile_banner(data.id) %}

{% if enable_incomplete_features %}
{% set title = data.username ~ "'s posts" %}
{% else %}
{% set title = data.username ~ "'s journals" %}
{% endif %}

{% block content %}
    {% set total_pages = (count / items_per_page) | round(0, 'ceil') %}
    {% set current_page = page %}

    <div class="section">
        <div class="section-header">
            <h1 class="section-title">{{ title }}</h1>
        </div>
        <div class="content-box basic-box">
            {% for journal in journals %}
                {{ include('/components/_post.twig') }}
            {% else %}
                <p>No journals!</p>
            {% endfor %}
        </div>
    </div>

    {% set le_url = '/user/' ~ user ~ '/journals?page=%s' %}

    {{ pagination(count, items_per_page, le_url, current_page) }}
{% endblock %}