{% extends "_layout.twig" %}

{% set title = upload.title %}

{% block scripts %}
    {{ include('upload_rating_script.twig') }}

    <script>
        upload_id = '{{ upload.id }}';
        upload_int_id = '{{ upload.int_id }}';
        user_id = '{{ upload.author.id }}';
        comment_type = 'upload';
        comment_id = '{{ upload.id }}';
    </script>
{% endblock %}

{% if upload.rating == 'mature' or upload.flags.mature %}
    {% set rating_text = localize('sensitive_rating') %}
{% else %}
    {% set rating_text = localize('general_rating') %}
{% endif %}

{% block content %}
{% if enable_incomplete_features %}
{% include('components/report_dialog.twig') %}
{% endif %}
    <div class="grid">
        <div class="col-medium-12 col-large-8 col-huge-9">
            <div class="section">
                <div class="upload-container">
                    {{ upload_view(upload) }}
                </div>
            </div>
            <div class="section">
                <div class="watch-box">
                    <div class="section watch-box-title">
                        <div class="section-header flex">
                            <div class="section-header-left">
                                <h1 class="section-title">
                                    {% if upload.title %}
                                        {{ upload.title }}
                                    {% else %}
                                        {{ localize('upload_no_title') }}
                                    {% endif %}
                                </h1>
                            </div>
                            <div class="section-header-right">
                                {% if upload.is_owner or user_is_authenticated_admin or enable_incomplete_features %}
                                <div class="menu-button button secondary button-transparent button-caret"
                                    data-menu-id="upload-{{ upload.id }}">
                                    {{ icon('three-dots', 16) }}
                                </div>
                                <div class="menu" id="upload-{{ upload.id }}">
                                    {% if upload.is_owner %}
                                        <a class="menu-item-button" href="/edit?v={{ upload.id }}">
                                            <span>{{ localize('edit') }}</span>
                                        </a>
                                    {% endif %}
                                    {% if user_is_authenticated_admin %}
                                        <a class="menu-item-button" href="/dashboard/uploads/{{ upload.id }}">
                                            <span>{{ localize('dashboard_lookup') }}</span>
                                        </a>
                                    {% endif %}
                                    {% if enable_incomplete_features %}
                                    <a class="menu-item-button" id="report-button">
                                        <span>{{ localize('report') }}</span>
                                    </a>
                                    {% endif %}
                                </div>
                                {% endif %}
                            </div>
                            {#{% if upload.is_owner %}
                                <div class="section-header-right">
                                    <a href="/edit?v={{ upload.id }}">{{ localize('edit') }}</a>
                                </div>
                            {% endif %}#}
                        </div>
                        <div class="watch-box-below-title">
                            {{ rating_text }}
                            {% if upload.flags.featured %}• <span class="watch-box-below-title-featured">{{ localize('featured') }}</span>{% endif %}
                        </div>
                        <hr>
                        <div class="watch-box-row">
                            <div class="watch-box-left">
                                <a href="/user/{{ upload.author.info.username }}">
                                    <div class="watch-box-profile-picture profile-picture user-id-{{ upload.author.id }}">
                                        <img class="pfp" src="{{ profile_picture(upload.author.id) }}">
                                    </div>
                                </a>
                                <div class="watch-box-author">
                                    <div class="watch-box-author-userlink">
                                        {{ user_link(upload.author) }}
                                    </div>
                                    <div class="watch-box-author-follow">
                                        {% if not upload.is_owner and not upload.author_banned and is_user_logged_in %}
                                            <button class="button secondary small" id="follow-user">
                                                {% if upload.author.following %}
                                                    {{ localize('unfollow') }}
                                                {% else %}
                                                    {{ localize('follow') }}
                                                {% endif %}
                                            </button>
                                            <span id="follower_count">{{ upload.author.followers }}</span>
                                        {% else %}
                                            <span class="watch-box-followers-logged-out">
                                                {{ localize('followers', upload.author.followers) }}
                                            </span>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                            <div class="watch-box-right">
                                <div class="watch-box-views">
                                    {{ upload.interactions.views | format_number }}
                                </div>
                                <div id="rater"></div>
                                <div class="watch-box-ratings-number">
                                     {{ localize('star_ratings', upload.interactions.ratings.total) }}
                                </div>
                            </div>
                        </div>
                        <hr>
                        <div class="watch-box-description">
                            <div class="flex">
                                <div class="watch-box-description-info">
                                    {{ localize('uploaded_on', upload.published | format_date('long', 'short')) }}
                                </div>
                                {#<div class="button danger small">Favorite</div>#}
                            </div>
                            {% if upload.published_originally and upload.original_site %}
                                <div class="watch-box-description-info-small">
                                    {{ localize('first_uploaded_on', upload.original_site, upload.published_originally | format_date('long', 'none')) }}
                                </div>
                            {% elseif upload.original_site %}
                                <div class="watch-box-description-info-small">
                                    {{ localize('originally_uploaded_on', upload.original_site )}}
                                </div>
                            {% endif %}
                            <div class="watch-box-description-contents">
                                {% if upload.description | trim is not empty %}
                                    {{ upload.description | markdown_user_written }}
                                {% else %}
                                    <span class="text-faded">{{ localize('upload_no_description') }}</span>
                                {% endif %}
                            </div>
                        </div>
                        {% if upload.tags %}
                            <hr>
                            <div class="watch-box-description">
                                <div class="watch-box-description-info-small">
                                    {{ localize('tags') }}:
                                    {% for tag in upload.tags %}
                                        <a href="/search?query={{ tag.name }}">{{ tag.name }}</a>{{ not loop.last ? ',' }}
                                    {% else %}
                                        <span class="text-faded">{{ localize('none') }}</span>
                                    {% endfor %}
                                    {# TODO:
                                    {% if is_user_logged_in %}
                                        <form class="form-flex">
                                            <input type="text" class="form-submit">
                                            <input type="submit" value="Add" class="button secondary">
                                        </form>
                                    {% endif %}
                                    #}
                                </div>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>
            <div class="section">
                <div id="comments">
                    <div class="content-box">
                        <div class="section-header flex">
                            <div class="section-header-left">
                                <h2 class="section-title">{{ localize('comments' )}}</h2>
                                <div class="section-desc">{{ upload.interactions.comments }}</div>
                            </div>
                        </div>
                        {% if not upload.flags.block_comments %}
                            {{ include('/components/_comment_input.twig') }}
                        {% else %}
                            <div>
                                <div id="new-comment-button">
                                    {{ localize('comments_disabled') }}
                                </div>
                            </div>
                        {% endif %}
                        {% for comment in upload.comments %}
                            {{ include('/components/_comment.twig') }}
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
        <div class="col-medium-12 col-large-4 col-huge-3">
            {% if upload.recommended %}
                <div class="section">
                    <div class="section-header flex">
                        <h2>{{ localize('related_uploads') }}</h2>
                    </div>
                    <div class="content-box related-uploads">
                        {% for upload in upload.recommended %}
                            {{ include('/components/_upload_vertical_small.twig') }}
                        {% endfor %}
                    </div>
                </div>
            {% endif %}
            {% if upload.other_by_author %}
                <div class="section">
                    <div class="section-header flex">
                        <h2>{{ localize('uploads_from_user', upload.author.info.displayname) }}</h2>
                    </div>
                    <div class="content-box related-uploads">
                        {% for upload in upload.other_by_author %}
                            {{ include('/components/_upload_vertical_small.twig') }}
                        {% endfor %}
                    </div>
                </div>
            {% endif %}
            {% if upload.random %}
                <div class="section">
                    <div class="section-header flex">
                        <h2>{{ localize('random_uploads') }}</h2>
                    </div>
                    <div class="content-box related-uploads">
                        {% for upload in upload.random %}
                            {{ include('/components/_upload_vertical_small.twig') }}
                        {% endfor %}
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}