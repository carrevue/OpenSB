{% extends "_layout_dashboard.twig" %}

{% if search %}
    {% set le_url = '?page=%s&amount=' ~ amount  ~ "&search=" ~ search %}
{% else %}
    {% set le_url = '?page=%s&amount=' ~ amount %}
{% endif %}

{% set title = "Accounts" %}

{% set breadcrumbs = [
    { url: '/dashboard/accounts', label: "Accounts" },
] %}

{% block dashboard_content %}
    {% set total_pages = (data.count / amount) | round(0, 'ceil') %}
    {% set current_page = page %}

    <div class="content-box">
        <div class="form-flex">
            <form action="/dashboard/accounts/" method="GET" id="num_change" class="admin-form-select">
                <select name="amount" onchange="this.form.submit()">
                    {% for option in [8, 16, 24, 32, 48, 64, 96, 128, 256] %}
                        <option value="{{ option }}" {{ amount == option ? 'selected' }}>{{ option }}</option>
                    {% endfor %}
                </select>
            </form>

            <form method="GET" action="/dashboard/accounts/" class="admin-form-search">
                <input type="hidden" name="amount" value="{{ amount }}">
                <input type="text" name="search" value="{{ search }}" placeholder="{{ localize('search') }}...">
                <button type="submit" class="button secondary">
                    {{ icon('search') }}
                </button>
            </form>
        </div>
        <hr>
        {% for account in accounts %}
            <div class="content-entry admin-entry">
                <div class="content-image profile-picture">
                    <img src="https://gravatar.com/avatar/{{ account.gravatar }}" alt="{{ account.email }}" class="pfp">
                </div>
                <div class="content-info">
                    <div class="content-title">
                        {{ account.email }} ({{ account.id }})
                    </div>
                    <div class="content-detail">
                        Default user:
                    </div>
                    <div class="content-detail">
                        Registered: {{ account.registered | relative_time() }}
                    </div>
                    <div class="content-detail">
                        Last sign in: {{ account.last_login | relative_time() }}
                    </div>
                    <div class="content-detail">
                        {#{% if user.info.flags.unverified and not user.banned %}
                            <span class="text-faded">Unverified</span>
                        {% endif %}
                        {% if user.banned %}
                            <span class="text-danger">Banned</span>
                        {% endif %}
                        {% if user.info.flags.featured %}
                            <span class="text-success">Featured</span>
                        {% endif %}#}
                    </div>
                </div>
                <div class="admin-user-buttons">
                    <a class="button secondary" href="/dashboard/accounts/{{ account.id }}">
                        Manage
                    </a>
                </div>
            </div>
        {% endfor %}
        {{ pagination(count, amount, le_url, current_page) }}
    </div>
{% endblock %}