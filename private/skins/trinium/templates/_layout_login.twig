{% if not (current_theme ends with 'flat') %}
    {% set logo_suffix = '-dark' %}
{% else %}
    {% set logo_suffix = current_theme starts with 'dark' ? '-dark' : '' %}
{% endif %}

{% set logo_extension = website_branding.is_vector ? '.svg' : '.png' %}
{% set logo_type = website_branding.use_wordmark ? 'logo-wordmark' : 'logo' %}

{% set logo = website_branding.assets_location ~ '/' ~ logo_type ~ logo_suffix ~ logo_extension %}

{% if is_chaziz_sb %}
    {% set logo_type = 'logo-wordmark' %}
{% endif %}

{% set logo = website_branding.assets_location ~ '/' ~ logo_type ~ logo_suffix ~ logo_extension %}

<!DOCTYPE html>
<html lang="{{ language_code }}" dir="ltr" class="{{ page_name|split(' ')|first }}">
<head>
    {{ include('_html_head.twig') }}
    <link rel="stylesheet" href="/assets/css/trinium-{{ current_theme }}.css?r={{ get_css_file_date() }}">
    {% if page_name == "register" and captcha_public_token %}
        <script src="https://js.hcaptcha.com/1/api.js" async defer></script>
    {% endif %}
    <style>
        {# this is done through twig because css does not support string addition or whatever the FUCK its called.
            -chaziz 2025-08-03 #}
        :root {
            {% if current_theme starts with 'dark' or not (current_theme ends with 'flat') %}
            --background: url('{{ website_branding.assets_location }}/login_background_dark.jpg');
            {% else %}
            --background: url('{{ website_branding.assets_location }}/login_background.jpg');
            {% endif %}
        }
    </style>
</head>
<body class="login">
<div class="headers">
    <div class="header">
        <div class="header-container">
            <div class="header-main">
                <div class="header-logo">
                    <a href="/">
                        <img alt="{{ website_branding.name }}" class="logo" src="{{ logo }}">
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="page">
    <div class="page-login">
        <div class="{{ page_name }}">
            {{ include(component('banners')) }}
            {% block content %}{% endblock %}
            <div class="login-text login-footer">{{ localize('footer_copyright', '2021-' ~ ('now' | date('Y'))) }}</div>
        </div>
    </div>
</div>
<script>
    opensb_version = '{{ opensb_version.name }} {{ opensb_version.string }}';
</script>
<script src="/assets/common.js?r={{ get_css_file_date() }}"></script>
<script src="/assets/skin/trinium/common_login_register.js?r={{ get_css_file_date() }}"></script> {# don't use normal common.js #}
<!-- {{ version_banner() }} -->
</body>
</html>