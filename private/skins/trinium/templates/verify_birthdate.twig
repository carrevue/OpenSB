{% extends "_layout_login.twig" %}

{% set title = localize('birthdate_verify') %}

	{% block content %}
        <div class="section">
        <div class="section-header">
            <h1 class="section-title">{{ localize('birthdate_verify') }}</h1>
        </div>
        <div class="content-box">
            <div class="grid center">
                <div class="col-6">
                    <p>{{ localize('birthdate_verify_intro', website_branding.name) }}</p>
                    <form method="post" name="loginForm" id="loginForm" action="/verify_birthdate" class="form-login">
                        <div class="form-input">
                            <label for="birthdate">{{ localize('birthdate') }}</label>
                            <input type="date" name="birthdate" required />
                        </div>

                        <div class="form-button-container">
                            <input type="submit" class="button button-primary" value="{{ localize('submit_action') }}" name="birthdatesubmit">
                        </div>
                    </form>
                </div>
                <div class="col-6 col-login-info">
                    <div class="login-currently-logged-in">
                        <div class="login-pfp">
                            <div class="profile-picture">
                                <img src="{{ profile_picture(user_data.name) }}" class="pfp"
                                     alt="{{ user_data.name }}">
                            </div>
                        </div>
                        <div>
                            <div class="login-currently-logged-in-text">
                                {{ localize('currently_logged_in_as', user_data.name) }}
                            </div>
                        </div>
                    </div>
                    <hr>
                    <div>
                        <p>{{ localize('birthdate_verify_explaination', website_branding.name) }}
                    </div>
                </div>
            </div>
        </div>
    {% endblock %}