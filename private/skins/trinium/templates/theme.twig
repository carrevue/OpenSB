{% extends "_layout.twig" %}

{% set title = localize('change_theme') %}

{# fix so the locale picker doesnt default to the first listed option #}
{% if options.locale == null %}
    {% set options = options|merge({locale: "en-US"}) %}
{% endif %}

{% block content %}
    <div class="section">
        <div class="section-header">
            <h1 class="section-title">{{ localize('change_theme') }}</h1>
        </div>
        <div class="content-box">
            <div id="previewContainer">
                <img id="themePreview" src="" alt="Theme Preview" class="thumbnail">
                <div id="skinThemeInfo">
                    <div id="skinName"></div>
                    <div id="skinDescription"></div>
                    <div id="skinAuthor"></div>
                    <div id="themeName"></div>
                    <div id="themeDescription"></div>
                    <div id="themeAuthor"></div>
                    <div id="notFullySupported" class="text-danger" style="display:none;">{{ localize('skin_unsupported') }}</div>
                </div>
            </div>
            <hr>
            <form name="themeForm" id="themeForm" method="post" action="/theme">
                <div class="form-input">
                    <label for="skin">{{ localize('skin') }}</label>
                    <select id="skin" name="skin" onchange="updateSkinThemes()">
                        {% for skin in skins %}
                            <option value="{{ skin.metadata.id }}" 
                                    data-description='{{ skin.metadata.description }}' 
                                    data-author='{{ skin.metadata.author }}'
                                    data-themes='{{ skin.metadata.themes|json_encode }}'
                                    {% if skin.metadata.id == current_skin %} selected{% endif %}>
                                {{ skin.metadata.name }}
                            </option>
                        {% endfor %}
                    </select>
                </div>
                <div class="form-input">
                    <label for="theme">{{ localize('theme') }}</label>
                    <select id="theme" name="theme" onchange="updatePreview()">
                    </select>
                </div>
                <hr>
                <div class="form-input">
                    <label for="locale">{{ localize('language') }}</label>
                    <select id="locale" name="locale">
                        {% for locale in locales %}
                            <option value="{{ locale.id }}"
                                    {% if options.locale == locale.id %} selected{% endif %}>
                                {{ locale.name }}
                            </option>
                        {% endfor %}
                    </select>
                </div>
                <br>
                <div class="form-button-container">
                    <input type="submit" id="apply" name="apply" value="{{ localize('apply_action') }}" class="button accent">
                </div>
            </form>
        </div>
    </div>
{% endblock %}

{% block scripts %}
    <script>
        currentSkinAndTheme = '{{ current_skin }},{{ current_theme }}';
        weOnTrinium = true;
    </script>
    <script src="/assets/theme.js?r={{ get_css_file_date() }}"></script>
{% endblock %}