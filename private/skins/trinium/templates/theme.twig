{% extends "_layout.twig" %}

{% set title = "Change theme" %}

{# fix so the locale picker doesnt default to the first listed option (which is belsrusian as of writing this) #}
{% if options.locale == null %}
    {% set options = options|merge({locale: "en-US"}) %}
{% endif %}

{% block content %}
    <div class="section">
        <div class="section-header">
            <h1 class="section-title">Change theme</h1>
        </div>
        <div class="content-box">
            <div id="previewContainer">
                <img id="themePreview" src="" alt="Theme Preview" class="thumbnail">
                <div id="skinThemeInfo">
                    <div id="skinName"></div>
                    <div id="skinDescription"></div>
                    <div id="skinAuthor"></div>
                    <div id="themeName"></div>
                    <div id="themeDescription"></div>
                    <div id="themeAuthor"></div>
                    <div id="notFullySupported" class="text-danger" style="display:none;">This skin is not fully supported and may not be completely functional</div>
                </div>
            </div>
            <hr>
            <form name="uploadForm" id="uploadForm" method="post" action="theme">
                <div class="form-input">
                    <label for="skin">Skin</label>
                    <select id="skin" name="skin" class="form-submit" onchange="updateSkinThemes()">
                        {% for skin in skins %}
                            <option value="{{ skin.metadata.id }}" 
                                    data-description='{{ skin.metadata.description }}' 
                                    data-author='{{ skin.metadata.author }}'
                                    data-themes='{{ skin.metadata.themes|json_encode }}'
                                    {% if skin.metadata.id == current_skin %} selected{% endif %}>
                                {{ skin.metadata.name }}
                            </option>
                        {% endfor %}
                    </select>
                </div>
                <div class="form-input">
                    <label for="theme">Theme</label>
                    <select id="theme" name="theme" class="form-submit" onchange="updatePreview()">
                    </select>
                </div>
                <hr>
                <div class="form-input">
                    <label for="locale">Locale</label>
                    <select id="locale" name="locale" class="form-submit">
                        {% for locale in locales %}
                            <option value="{{ locale.id }}"
                                    {% if options.locale == locale.id %} selected{% endif %}>
                                {{ locale.name }}
                            </option>
                        {% endfor %}
                    </select>
                </div>
                <br>
                <div class="form-button-container">
                    <input type="submit" id="apply" name="apply" value="Apply" class="button primary">
                </div>
            </form>
        </div>
    </div>
{% endblock %}

{% block scripts %}
    <script>
        currentSkinAndTheme = '{{ current_skin }},{{ current_theme }}';
        weOnTrinium = true;
    </script>
    <script src="/assets/theme.js?r={{ get_css_file_date() }}"></script>
{% endblock %}