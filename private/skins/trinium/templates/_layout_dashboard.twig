{% extends "_layout.twig" %}


{% block precontent %}
<div class="navigation-bar">
    <a class="navigation-bar-button {% if page_name=='dashboard-overview' %}active{% endif %}" href="/dashboard/overview">
        Overview
    </a>
    <a class="navigation-bar-button {% if page_name=='dashboard-users' %}active{% endif %}" href="/dashboard/users">
        Users
    </a>
    {% if user_data.powerlevel > 2 %}
        <a class="navigation-bar-button {% if page_name=='dashboard-ip_bans' %}active{% endif %}" href="/dashboard/ip_bans">
            IP bans
        </a>
    {% endif %}
    <a class="navigation-bar-button {% if page_name=='dashboard-uploads' %}active{% endif %}" href="/dashboard/uploads">
        Uploads
    </a>
    <a class="navigation-bar-button {% if page_name=='dashboard-journals' %}active{% endif %}" href="/dashboard/journals">
        Journals
    </a>
    <a class="navigation-bar-button {% if page_name=='dashboard-interactions' %}active{% endif %}" href="/dashboard/interactions">
        Interactions
    </a>
    {% if invite_keys_enabled %}
        <a class="navigation-bar-button {% if page_name=='dashboard-invite_keys' %}active{% endif %}" href="/dashboard/invite_keys">
            Invite keys
        </a>
    {% endif %}
</div>
{% endblock %}

{% block content %}
    <div class="section">
        <div class="section-header">
            <h1 class="section-title">
                {{ title }}
            </h1>
        </div>
    </div>
    <div class="content-box">
        {% block admincontent %}
        {% endblock %}
    </div>
{% endblock %}