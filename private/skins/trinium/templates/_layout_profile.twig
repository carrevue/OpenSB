{% extends "_layout.twig" %}

{% set cssVars = {
    'bg-page': 'background_color',
    'link-color': 'link_color',
    'title-color': 'title_color',

    'highlight-bg': 'highlight_box_background_color',
    'highlight-border': 'highlight_box_border_color',
    'highlight-text': 'highlight_box_text_color',

    'basic-bg': 'basic_box_background_color',
    'basic-border': 'basic_box_border_color',
    'basic-text': 'basic_box_text_color'
} %}

{% block style %}
        <style>
        :root {
        {% if data.customization %}
            {% for cssVar, key in cssVars %}
                {% if data.customization[key] is not empty %}
            --{{ cssVar }}: {{ data.customization[key] }};
                    {% if data.customization[key ~ '_rgb'] is defined %}
            --{{ cssVar }}-rgb: {{ data.customization[key ~ '_rgb'] }};
                    {% endif %}
                {% endif %}
            {% endfor %}

            {% if data.customization.font %}
            --page-font: {{ data.customization.font | raw }};
            {% endif %}
        {% endif %}

            --username-color: {{ data.color }};
        }

        {% if banner_picture %}
        .jumbotron.profile-banner {
        {% if data.customization %}
            background-color: {{ data.customization.background_color }};
        {% endif %}
            background-image: url('{{ banner_picture }}');
        }
        {% endif %}

        {% if data.customization %}
        body {
            background: var(--bg-page);
        }
        
        /* Font */
        .page {
            font-family: var(--page-font, inherit);
        }

        /* Links */
        a {
            color: var(--link-color);
        }

        /* Titles */
        .section-title {
            color: var(--title-color);
        }

        /* Highlight box */
        .content-box.highlight-box {
            background-color: var(--highlight-bg);
            border-color: var(--highlight-border);
            color: var(--highlight-text);
        }

        .content-box.highlight-box hr,
        .profile-details .profile-details-list .detail-item {
            border-color: var(--highlight-border);
        }

        /* Basic box */
        .content-box.basic-box {
            background-color: var(--basic-bg);
            border-color: var(--basic-border);
            color: var(--basic-text);
        }

        .content-box.basic-box hr,
        .content-box.basic-box .content-entry,
        .content-box.basic-box .post,
        .content-box.basic-box .replies,
        .content-box.basic-box .new-post,
        .content-box.basic-box .reply-form {
            border-color: var(--basic-border);
        }

        /* Tabs */
        .content-box.basic-box .tabs,
        .content-box.basic-box .tablink.active {
            border-color: var(--basic-border);
        }

        .content-box.basic-box .tablink:hover {
            background-color: rgb(var(--basic-bg-rgb) / 50%);
        }

        .content-box.basic-box .tablink:active,
        .content-box.basic-box .tablink.active {
            background-color: var(--basic-bg);
            color: var(--title-color);
        }


        /* Footer */
        .footer .footer-container {
            padding-top: 1em;
            color: var(--basic-text);
            border-top: 1px solid var(--basic-border);
        }

        .footer .footer-container .footer-copyright {
            opacity: 1;
        }

        /* Posts/Userlink */
        .post .post-body .post-author .post-timestamp,
        .userlink-container .userlink .userlink-handle {
            color: var(--basic-text);
            opacity: 1;
        }

        .userlink-container .userlink a {
            color: var(--basic-text) !important;
        }
        {% endif %}
        
        .profile-box-username {
            color: var(--username-color);
        }
    </style>
{% endblock %}

{% block precontent %}
    {% block precontentappend %}
    {% endblock %}
    {% if banner_picture %}
    <div class="jumbotron profile-banner {% if options.trinium_show_sidebar %}sidebar-active{% endif %}" id="profile-banner"></div>
    {% endif %}
{% endblock %}

{% block content %}{% endblock %}
