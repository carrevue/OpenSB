{% extends "_layout.twig" %}

{% block style %}
    <style>
        {% if banner_picture %}
        .jumbotron.profile-banner {
        {% if data.customization %}
            background-color: {{ data.customization.background_color }};
        {% endif %}
            background-image: url('{{ banner_picture }}');
        }
        {% endif %}

        {% if data.customization %}
        body {
            background: {{ data.customization.background_color }};
        }

        {% if data.customization.font %}
        /* Font */
        .page {
            font-family: {{ data.customization.font | raw }};
        }
        {% endif %}

        /* Links */
        a {
            color: {{ data.customization.link_color }};
        }

        /* Titles */
        .section-title {
            color: {{ data.customization.title_color }};
        }

        /* Highlight box */
        .content-box.highlight-box {
            background-color: {{ data.customization.highlight_box_background_color }};
            border-color: {{ data.customization.highlight_box_border_color }};
            color: {{ data.customization.highlight_box_text_color }};
        }

        .content-box.highlight-box hr,
        .profile-details-list .detail-item {
            border-color: {{ data.customization.highlight_box_border_color }};
        }

        /* Basic box */
        .content-box.basic-box {
            background-color: {{ data.customization.basic_box_background_color }};
            border-color: {{ data.customization.basic_box_border_color }};
            color: {{ data.customization.basic_box_text_color }};
        }

        /* Comment borders */
        .content-box.basic-box hr,
        .content-box.basic-box .content-entry,
        .content-box.basic-box .comment,
        .content-box.basic-box .replies,
        .content-box.basic-box .new-comment,
        .content-box.basic-box .reply-form {
            border-color: {{ data.customization.basic_box_border_color }};
        }

        /* Footer */
        .footer .footer-container {
            padding-top: 1em;
            color: {{ data.customization.basic_box_text_color }};
            border-top: 1px solid {{ data.customization.basic_box_border_color }};
        }

        .footer .footer-container .footer-copyright {
            opacity: 100%;
        }

        /* Comments/Userlink */
        .comment .comment-body .comment-author .comment-timestamp {
            color: {{ data.customization.basic_box_text_color }};
            opacity: 100%;
        }

        .userlink .userlink-bullshit span {
            color: {{ data.customization.basic_box_text_color }} !important;
        }
        {% endif %}
    </style>
{% endblock %}

{% block precontent %}
    {% if banner_picture %}
    <div class="jumbotron profile-banner"></div>
    {% endif %}
{% endblock %}

{% block content %}{% endblock %}
