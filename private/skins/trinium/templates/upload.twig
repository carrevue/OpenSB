{% extends "_layout.twig" %}

{% set show_sidebar = true %}

{% set title = localize('new_upload') %}

	{% block content %}
        <div class="section">
            <div class="section-header">
                <h1 class="section-title">{{ localize('new_upload') }}</h1>
                <div>
                    {{ localize('new_upload_intro', '/guidelines') | raw }}
                </div>
                <div class="text-danger">
                    {{ localize('reupload_warning') }}
                </div>
            </div>
            <div class="content-box">
                <form name="uploadForm" id="uploadForm" method="post" action="upload" enctype="multipart/form-data">
                    <div class="panel panel-default">
                        <div class="panel-body">
                            <div class="form-input">
                                <label for="title">{{ localize('title') }} <span>{{ localize('form_required') }}</span></label>
                                <input type="text" class="form-submit" id="title" name="title" required>
                            </div>

                            <div class="form-input">
                                <label for="desc">{{ localize('description') }} <span>{{ localize('form_optional') }}</span></label>
                                <textarea class="form-submit" name="desc" maxlength="65535"
                                          form="uploadForm"
                                          style="overflow-x:hidden;resize:vertical" rows="8"></textarea>
                            </div>

                            <div class="form-input">
                                <label for="tags">{{ localize('tags') }} <span>{{ localize('form_optional') }}</span></label>
                                <input type="text" class="form-submit" name="tags">
                            </div>

                            {% if not is_chaziz_sb %}
                            <div class="form-input">
                                <input type="checkbox" name="rating" id="rating" value="true">
                                <label for="rating">{{ localize('mark_as_sensitive') }}
                                <span>{{ localize('mark_as_sensitive_description') }}</span>
                                </label>
                            </div>
                            {% endif %}

                            <div class="form-input">
                                <label for="fileToUpload">{{ localize('file') }} <span>{{ localize('form_required') }}</span></label>
                                <div>{{ localize('upload_limit', limit) }}</div>
                                <div>{{ localize('supported_files') }}</div>
                                <input class="form-submit" type="file" name="fileToUpload" id="fileToUpload" required>
                            </div>

                            <div class="form-button-container">
                                <input class="button button-primary" type="submit" id="upload" name="upload"
                                       value="{{ localize('upload_action') }}">
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    {% endblock %}