{% extends "_layout.twig" %}

{% set show_sidebar = true %}

{% set title = localize("new_upload") %}

	{% block content %}
        <div class="section">
            <div class="section-header">
                <h1 class="section-title">{{ localize("new_upload") }}</h1>
                <div>
                    Make sure you have read the <a href="/guidelines">community guidelines</a> first. Failure to comply
                    with the community guidelines will result in your upload being taken down.
                </div>
                <div class="text-danger">
                    Reminder: Do not reupload content that you have not made.
                </div>
            </div>
            <div class="content-box">
                <form name="uploadForm" id="uploadForm" method="post" action="upload" enctype="multipart/form-data">
                    <div class="panel panel-default">
                        <div class="panel-body">
                            <div class="form-input">
                                <label for="title">Title <span>Required</span></label>
                                <input type="text" class="form-submit" id="title" name="title" required>
                            </div>

                            <div class="form-input">
                                <label for="desc">Description <span>Optional</span></label>
                                <textarea class="form-submit" name="desc" maxlength="65535"
                                          form="uploadForm"
                                          style="overflow-x:hidden;resize:vertical" rows="8"></textarea>
                            </div>

                            <div class="form-input">
                                <label for="tags">Tags <span>Optional</span></label>
                                <input type="text" class="form-submit" name="tags">
                            </div>

                            {% if not is_chaziz_sb %}
                            <div class="form-input">
                                <input type="checkbox" name="rating" id="rating" value="true">
                                <label for="rating">Mark as sensitive
                                <span>Makes the upload only accessible to logged-in users over 18.</span>
                                </label>
                            </div>
                            {% endif %}

                            <div class="form-input">
                                <label for="fileToUpload">File <span>Required</span></label>
                                <div>Upload limit: {{ limit }}</div>
                                <div>Common video and image formats are supported.</div>
                                <input class="form-submit" type="file" name="fileToUpload" id="fileToUpload" required>
                            </div>

                            <div class="form-button-container">
                                <input class="button button-primary" type="submit" id="upload" name="upload"
                                       value="Upload">
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    {% endblock %}