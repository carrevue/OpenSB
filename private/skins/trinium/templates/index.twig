{% extends "_layout.twig" %}

{% if is_user_logged_in %}
    {% set jumbotronClassName = "homepage-logged-in" %}
{% else %}
    {% set jumbotronClassName = "homepage-logged-out" %}
{% endif %}

{% block precontent %}
    <div class="jumbotron page-banner homepage">
        <div class="jumbotron-container {{ jumbotronClassName }}">
            <div class="jumbotron-welcome">
                {% if is_user_logged_in %}
                    <div class="profile-picture">
                        <img src="{{ profile_picture(user_data.id) }}" class="pfp" alt="{{ user_data.name }}">
                    </div>
                    <div class="jumbotron-logged-in-text">
                        <h1>{{ localize('welcome_logged_in', user_data.title) }}</h1>
                        <div>@{{ user_data.name }} • {{ localize('followers', user_stat_data.followers) }}
                            • {{ localize('views', user_stat_data.views) }}</div>
                    </div>
                {% else %}
                    <h1>{{ localize('welcome_logged_out', website_branding.name) }}</h1>
                    {% if slogan %}
                        <p class="jumbotron-slogan"><q>{{ slogan }}</q></p>
                    {% elseif is_chaziz_sb %}
                        <p class="jumbotron-slogan">{{ localize('welcome_slogan') }}</p>
                    {% endif %}
                    <div class="jumbotron-get-started">
                        <a href="/register" class="button warning">{{ localize('welcome_get_started') }}</a>
                        <span>← {{ localize('welcome_its_free') }}</span>
                    </div>
                {% endif %}
            </div>
            <div class="jumbotron-right-container">
                <div class="jumbotron-right-date">
                    {{ date() | format_date('long', 'none') }}
                </div>
                {% if enable_incomplete_features %}
                <div class="jumbotron-right-buttons">
                    <div class="tabs homepage">
                        <div class="tablink homepage {% if type=='list' %}active{% endif %}" id="index-list-button">
                            {{ icon('homepage-list', 24) }}
                        </div>
                        <div class="tablink homepage {% if type =='wavelet' %}active{% endif %}" id="index-wavelet-button">
                            {{ icon('homepage-wavelet', 24) }}
                        </div>
                    </div>
                </div>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}

{# TODO: new "empty instance" thing #}
{% block content %}
    <div class="grid cluster">
        <div class="col-8">
            {% if enable_incomplete_features and type == 'wavelet' %}
                {{ include('/components/_index_wavelet.twig') }}
            {% else %}
                {{ include('/components/_index_list.twig') }}
            {% endif %}
        </div>
        <div class="col-4">
            {% if data.news_recent %}
            <div class="section">
                {# work around awkwardly defined array #}
                {% set news = data.news_recent|first %}
                <div class="content-box">
                    <div class="content-entry">
                        <div class="content-info">
                            <div class="content-title">{{ news.title }}</div>
                            <div class="content-author">{{ user_link(news.author) }}</div>
                            <div class="content-detail">{{ news.published | format_date('long', 'none') }}</div>
                            <div class="content-text">{{ news.contents | markdown_user_written(true) }}</div>
                            <a href="/posts/news">{{ localize('site_news_previous') }}</a>
                        </div>
                    </div>
                </div>
            </div>
            {% endif %}
            {% if data.users_recent %}
            <div class="section">
                <div class="section-header flex">
                    <div class="section-header-left">
                        <h2 class="section-title">{{ localize('recent_members') }}</h2>
                        <div class="section-desc">{{ localize('recent_members_desc') }}</div>
                    </div>
                    <div class="section-header-right">
                        <a href="/users">{{ localize('more') }}</a>
                    </div>
                </div>
                <div class="content-box">
                    {% for user in data.users_recent %}
                        <div class="content-entry centered index-user user-id-{{ user.id }}">
                            <div class="content-thumbnail">
                                <a href="/user/{{ user.info.username }}">
                                    <div class="content-image profile-picture">
                                        <img src="{{ profile_picture(user.id) }}" alt="{{ user.info.username }}" class="pfp">
                                    </div>
                                </a>
                            </div>
                            <div class="content-info">
                                <div class="content-title">
                                    {{ user_link(user) }}
                                </div>
                                <div class="content-detail">
                                    {{ localize('followers', user.followers) }} • {{ localize('upload_count', user.uploads) }}
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
            {% endif %}
        </div>
    </div>
{% endblock %}
