{% extends "_layout_dashboard.twig" %}

{% if search %}
    {% set le_url = '?page=%s&amount=' ~ amount  ~ "&search=" ~ search %}
{% else %}
    {% set le_url = '?page=%s&amount=' ~ amount %}
{% endif %}

{% set title = "Users" %}

	{% block admincontent %}
        {% set total_pages = (data.count / amount) | round(0, 'ceil') %}
        {% set current_page = page %}

        <div class="form-flex">
            <form action="/dashboard/users/" method="GET" id="num_change" class="admin-form-select">
                <select name="amount" onchange="this.form.submit()">
                    {% for option in [8, 16, 24, 32, 48, 64, 96, 128, 256] %}
                        <option value="{{ option }}" {{ amount == option ? 'selected' }}>{{ option }}</option>
                    {% endfor %}
                </select>
            </form>

            <form method="GET" action="/dashboard/users/" class="admin-form-search">
                <input type="hidden" name="amount" value="{{ amount }}">
                <input type="text" name="search" value="{{ search }}" placeholder="{{ localize('search') }}...">
                <button type="submit" class="button button-secondary">
                    {{ icon('search') }}
                </button>
            </form>
        </div>
        <hr>
        {% for user in users %}
            <div class="content-entry admin-entry">
                <div class="content-image profile-picture">
                    <a href="/user/{{ user.info.username }}">
                        <img src="{{ profile_picture(user.info.username) }}" alt="{{ user.info.username }}" class="pfp">
                    </a>
                </div>
                <div class="content-info">
                    <div class="content-title">
                        {{ user_link(user) }}
                    </div>
                    <div class="content-description">
                        <div>
                            {{ user.uploads }} uploads · {{ user.journals }} journals
                        </div>
                        <div>
                            Role:
                            {% set role = 
                                user.powerlevel == 1 ? 'User' :
                                user.powerlevel == 2 ? 'Moderator' :
                                user.powerlevel == 3 ? 'Administrator' :
                                user.powerlevel == 4 ? 'Owner' :
                                'Unknown (' ~ user.powerlevel ~ ')'
                            %}
                            {{ role }}
                        </div>
                        <div>
                            Registered: {{ user.info.joined | relative_time() }}
                        </div>
                        <div>
                            Last seen: {{ user.info.connected | relative_time() }}
                        </div>
                        <div>
                            {% if user.info.flags.unverified %}
                                <span class="text-danger">Unverified</span>
                            {% endif %}
                            {% if user.info.flags.featured %}
                                <span class="text-success">Featured</span>
                            {% endif %}
                        </div>
                    </div>
                </div>
                <div class="admin-user-buttons">
                    <a class="button button-secondary" href="/dashboard/users/{{ user.info.username }}">
                        Manage
                    </a>
                </div>
            </div>
        {% endfor %}
        {{ pagination(count, amount, le_url, current_page) }}
    {% endblock %}