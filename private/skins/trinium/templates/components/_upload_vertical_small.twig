{% if upload.type == 0 %}
    {% set icon = "video" %}
{% elseif upload.type == 2 %}
    {% set icon = "image" %}
{% else %}
    {% set icon = "placeholder" %}
{% endif %}

{% if upload.published_originally and upload.original_site %}
    {% set time = upload.published_originally %}
{% else %}
    {% set time = upload.published %}
{% endif %}

<div class="content-entry">
    <div class="content-thumbnail">
        <a href="/view/{{ upload.id }}">
            <img src="{{ thumbnail(upload.id, upload.type, upload.flags.custom_thumbnail) }}"
                 alt="{{ upload.title }}" class="content-image thumbnail small">
        </a>
        <div class="content-thumbnail-badge-container">
            <div class="content-thumbnail-badge">
                {{ icon(icon) }}
            </div>
            {% if upload.type == 0 %}
                <div class="content-thumbnail-badge timestamp">
                    {{ convert_time(upload.length) }}
                </div>
            {% endif %}
        </div>
    </div>
    <div class="content-info">
        <div class="content-title">
            <a href="/view/{{ upload.id }}">
                {% if upload.title|trim is not empty %}
                    {{ upload.title }}
                {% else %}
                    No title
                {% endif %}
            </a>
        </div>
        <div class="content-author">
            {{ user_link(upload.author) }}
        </div>
        <div class="content-info">
            {{ localize('views', upload.views) }} • <span class="use-tooltip" title="{{ time | format_date('long', 'none') }}">{{ time | relative_time }}</span>
            {% if upload.published_originally and upload.original_site %}
                <span class="text-faded">on {{ upload.original_site }}</span>
            {% endif %}
        </div>
        <div class="content-rating">
            {{ show_ratings(upload.interactions.ratings) }}
        </div>
    </div>
</div>