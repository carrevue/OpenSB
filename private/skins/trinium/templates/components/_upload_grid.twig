<div class="content-entry-small">
    <div class="content-image-container">
        <a href="/view/{{ upload.id }}" class="content-image-link">
            <img src="{{ thumbnail(upload.id, upload.type, upload.flags.custom_thumbnail) }}"
                 alt="{{ upload.title }}"
                 title="{{ upload.title }} by {{ upload.author.info.username }}"
                 class="content-image thumbnail" loading="lazy">
        </a>
    </div>
    <div class="content-title">
        <a href="/view/{{ upload.id }}">{{ upload.title }}</a>
    </div>
    <div class="content-author">
        {{ user_link(upload.author) }}
    </div>
    <div class="content-rating">
        {{ show_ratings(upload.interactions.ratings) }}
    </div>
</div>