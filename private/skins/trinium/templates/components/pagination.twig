{% set pages = (levels / lpp) | round(0, 'ceil') %}
{% set range = 3 %}
{% set start = current - range %}
{% set end = current + range %}

{% if start < 1 %}
    {% set end = end + (1 - start) %}
    {% set start = 1 %}
{% endif %}
{% if end > pages %}
    {% set start = start - (end - pages) %}
    {% set end = pages %}
{% endif %}
{% if start < 1 %}
    {% set start = 1 %}
{% endif %}

{% if pages > 1 %}
    <div class="pagination">
        {% if start > 1 %}
            <a class="pagination-item" href="{{ url | format(1) }}">1</a>
            {% if start > 2 %}
                <div class="pagination-item ellipsis">...</div>
            {% endif %}
        {% endif %}
        {% for page in start..end %}
            {% if page != current %}
                <a class="pagination-item" href="{{ url | format(page) }}">{{ page }}</a>
            {% else %}
                <span class="pagination-item current">{{ page }}</span>
            {% endif %}
        {% endfor %}
        {% if end < pages %}
            {% if end < pages - 1 %}
                <div class="pagination-item ellipsis">...</div>
            {% endif %}
            <a class="pagination-item" href="{{ url | format(pages) }}">{{ pages }}</a>
        {% endif %}
    </div>
{% endif %}