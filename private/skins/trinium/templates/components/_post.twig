<div class="post" id="post-{{ post.id }}">
    <a href="/user/{{ post.author.info.username }}">
        <div class="profile-picture user-id-{{ post.author.id }}">
            <img src="{{ profile_picture(post.author.id) }}" class="pfp" alt="{{ post.author.info.username }}">
        </div>
    </a>
    <div class="post-body">
        <div class="post-author">
            {{ user_link(post.author) }}
            <span class="post-timestamp use-tooltip" title="{{ post.published | format_date('long', 'medium') }}">{{ post.published | relative_time }}</span>
        </div>
        <div class="post-contents">
            {% if post.contents | trim is not empty %}
                {{ post.contents | markdown_user_written }}
            {% endif %}
        </div>
        <div class="post-actions">
            <a class="action-button">Action</a>
            <a class="action-button">Action</a>
            <a class="action-button">Action</a>
            <a class="action-button">Action</a>
        </div>
    </div>
</div>