<ul class="list">
    {% for key, link in header_main_links() %}
        <li class="list-link">
            <a href="{{ link.url }}" {% if page_name == key %}class="selected"{%endif %}>
                {#<div class="biscuit-icon placeholder"></div>#}
                {{ link.name }}
            </a>
        </li>
    {% endfor %}
    {% if sidebar_following_users() %}
        <li class="list-header">{% if is_user_logged_in %}Following{% else %}Best of {{ website_branding.name }}{% endif %}</li>
        {% for key, link in sidebar_following_users() %}
            <li class="list-link">
                <a href="/user/{{ link.username }}" {% if page_name == "user " ~ link.username %}class="selected"{%endif %}>
                    <div class="list-link-profile-picture profile-picture">
                        <img src="{{ profile_picture(link.username) }}" class="pfp" alt="{{ link.username }}">
                    </div>
                    {{ link.username }}
                </a>
            </li>
        {% endfor %}
    {% endif %}
</ul>