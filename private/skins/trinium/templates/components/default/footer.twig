<footer class="footer">
    <div class="footer-container">
        <div>
            <span>{{ localize('powered_by') }} <a href="/version">OpenSB {{ opensb_version }}</a></span>
        </div>
        {% for link in footer_links() %}
            <span><a href="{{ link.url }}">{{ link.name }}</a></span>
        {% endfor %}
        {% if is_debug %}
            <div>
                {{ profiler_stats() }}
            </div>
        {% endif %}
        <div class="footer-copyright">
            <span>{{ localize('footer_copyright', '2021-' ~ ('now' | date('Y'))) }}</span>
        </div>
        {% if is_debug %}
            <div>
                <a class="button button-danger button-small" title="Spicy!" id="debug-button">{{ localize('debug') }}</a>
            </div>
        {% endif %}
    </div>
</footer>