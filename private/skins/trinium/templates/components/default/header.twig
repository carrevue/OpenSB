<div class="header">
    <div class="header-container {% if not logged_in %}logged-out{% endif %}">
        <div class="header-main">
            {% if not options.trinium_old_header %}
                <div class="header-button">
                    <div class="button toolbar no-padding transparent" id="button-sidebar">
                        {{ icon('hamburger', 32) }}
                    </div>
                </div>
            {% endif %}
            <div class="header-logo">
                <a href="/">
                    <img alt="{{ website_branding.name }}" class="logo" src="{{ logo }}">
                </a>
            </div>
            {% if options.trinium_old_header %}
                <div class="header-links">
                    {% for key, link in sidebar_main_links() %}
                        <a href="{{ link.url }}">{{ link.name }}</a>
                    {% endfor %}
                </div>
            {% endif %}
            <form class="header-search" action="/search">
                <input id="header-search-input" type="text" name="query" placeholder="{{ localize('search') }}">
                <button id="header-search-button">
                    {{ icon('search') }}
                </button>
            </form>
        </div>
        <div class="header-links">
            {% if logged_in %}
                {% if not options.trinium_old_header %}
                {# create #}
                    <div class="header-menu-container">
                        <div class="menu-button" data-menu-id="create-menu">
                            {{ icon('upload') }}
                        </div>
                        <div class="menu" id="create-menu">
                            <a class="menu-item-button" href="/upload">{{ localize('new_upload') }}</a>
                            <a class="menu-item-button" href="/write">{{ localize('new_journal') }}</a>
                        </div>
                    </div>
                    {# notifications #}
                    <div class="header-menu-container">
                        <div class="menu-button" data-menu-id="notify-menu">
                            {{ icon('bell') }}
                        </div>
                        <div class="menu" id="notify-menu">
                            <a class="menu-item-button" href="/notifications">{{ localize('notifications') }} ({{ user_stat_data.notifications }})</a>
                            {% if enable_incomplete_features and options.exp_inbox %}
                            <a class="menu-item-button" href="/my_messages">Messages (0)</a>
                            {% endif %}
                        </div>
                    </div>
                {% endif %}
                {# user #}
                <div class="header-menu-container">
                    <div class="menu-button" data-menu-id="user-menu">
                        <div class="profile-picture user-menu-pfp">
                            <img src="{{ profile_picture(user_data.id) }}" class="pfp" alt="{{ user_data.name }}">
                        </div>
                        {% if options.trinium_old_header %}
                            <div class="menu-caret-container">
                                {{ icon('caret-closed', 16, 'menu-caret') }}
                            </div>
                        {% endif %}
                    </div>
                    <div class="menu" id="user-menu">
                        {% if not options.trinium_old_header %}
                            <div class="user-menu-email">{{ account_data.email }}</div>
                            <div class="user-menu-intro">
                                <div class="user-menu-intro-left">
                                    <div class="profile-picture">
                                        <img src="{{ profile_picture(user_data.id) }}" class="pfp"
                                             alt="{{ user_data.name }}">
                                    </div>
                                </div>
                                <div class="user-menu-intro-right">
                                    <div class="user-menu-intro-name">
                                        {{ user_data.title }}
                                    </div>
                                    <div class="user-menu-intro-stat">
                                        {{ localize('followers', user_stat_data.followers) }}
                                    </div>
                                    <div class="user-menu-intro-stat">
                                        {{ localize('views', user_stat_data.views) }}
                                    </div>
                                </div>
                            </div>
                            <hr>
                        {% endif %}
                        {% for link in header_user_links() %}
                            <a class="menu-item-button" href="{{ link.url }}">{{ link.name }}</a>
                        {% endfor %}
                        <hr>
                        <div class="user-switcher">
                            {% for link in header_user_switcher_links() %}
                                <a class="menu-item-button" href="/login/{{ link.name }}">
                                    <div class="menu-item-profile-picture profile-picture">
                                        <img src="{{ profile_picture(link.id) }}" class="pfp"
                                            alt="{{ link.title }}" loading="lazy">
                                    </div>
                                    <span>{{ link.title }}</span>
                                </a>
                            {% endfor %}
                        </div>
                        <hr>
                        <a class="menu-item-button small" href="/logout"><span>{{ localize('logout') }}</span></a>
                    </div>
                </div>
            {% else %}
                {% if options.trinium_old_header %}
                    {% for link in header_user_links() %}
                        <a href="{{ link.url }}">{{ link.name }}</a>
                    {% endfor %}
                {% else %}
                    <div class="header-menu-container">
                        <div class="menu-button" data-menu-id="login-menu">
                            <div class="menu-button-text"><span class="have-an-account">{{ localize('have_an_account') }}</span> {{ localize('login') }}</div>
                            <div class="menu-caret-container">
                                {{ icon('caret-closed', 16, 'menu-caret') }}
                            </div>
                        </div>
                        <div class="menu" id="login-menu">
                            <form method="post" name="loginForm" id="loginForm" action="/login" class="form-login">
                                <input type="hidden" name="csrf_token" value="{{ session.csrf_token }}">

                                <div class="form-input">
                                    <label for="email">{{ localize('email_address') }}</label>
                                    <input type="email" name="email">
                                </div>

                                <div class="form-input">
                                    <label for="password">{{ localize('password') }}</label>
                                    <input type="password" name="password">
                                </div>

                                <div class="login-bottom">
                                    <div class="login-text">
                                        {{ localize('dont_have_an_account') }} <a href="/register">{{ localize('register') }}</a>
                                    </div>

                                    <div class="form-button-container">
                                        <input type="submit" class="button accent button-login" value="{{ localize('login') }}" name="loginsubmit">
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                {% endif %}
            {% endif %}
        </div>
    </div>
</div>
{% if not options.trinium_old_header %}
<div class="hamburger" id="hamburger">
    {% include('components/_sidebar.twig') %}
</div>
{% endif %}