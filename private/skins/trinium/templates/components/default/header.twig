<div class="header">
    <div class="header-container {% if not is_user_logged_in %}logged-out{% endif %}">
        <div class="header-main">
            <div class="header-button">
                <div class="button button-secondary button-hamburger button-transparent" id="button-hamburger">
                    {{ icon("hamburger", 32) }}
                </div>
            </div>
            <div class="header-logo">
                <a href="/">
                    <img alt="{{ website_branding.name }}" class="logo" src="{{ logo }}">
                </a>
            </div>
            {% if not show_sidebar %}
                <div class="header-hidden-links">
                {% for key, link in header_main_links() %}
                    <a class="menulink" href="{{ link.url }}">
                        {{ link.name }}
                    </a>
                {% endfor %}
                </div>
            {% endif %}
            <form class="header-search" action="/search">
                <input id="header-search-input" type="text" name="query" placeholder="{{ localize('search') }}...">
                <button id="header-search-button">
                    {{ icon("search") }}
                </button>
            </form>
        </div>
        <div class="header-links">
            {% if is_user_logged_in %}
                {# create #}
                <div class="user-menu-container">
                    <div class="menu-button user-menu-button" data-menu-id="create-menu">
                        {{ icon("upload") }}
                    </div>
                    <div class="menu" id="create-menu">
                        <a class="menu-item-button" href="/upload">{{ localize('new_upload') }}</a>
                        <a class="menu-item-button" href="/write">{{ localize('new_journal') }}</a>
                    </div>
                </div>
                {# notifications #}
                <div class="user-menu-container">
                    <div class="menu-button user-menu-button" data-menu-id="notify-menu">
                        {{ icon("bell") }}
                    </div>
                    <div class="menu" id="notify-menu">
                        <a class="menu-item-button" href="/notifications">Notifications ({{ user_stat_data.notifications }})</a>
                        <a class="menu-item-button" href="/my_messages">Messages (0)</a>
                    </div>
                </div>
                {# user #}
                <div class="user-menu-container">
                    <div class="menu-button user-menu-button" data-menu-id="user-menu">
                        <div class="profile-picture user-menu-pfp">
                            <img src="{{ profile_picture(user_data.name) }}" class="pfp" alt="{{ user_data.name }}">
                        </div>
                    </div>
                    <div class="menu" id="user-menu">
                            <div class="user-menu-intro">
                                <div class="user-menu-intro-left">
                                    <div class="profile-picture">
                                        <img src="{{ profile_picture(user_data.name) }}" class="pfp"
                                             alt="{{ user_data.name }}">
                                    </div>
                                </div>
                                <div class="user-menu-intro-right">
                                    <div class="user-menu-intro-name">
                                        {{ user_data.name }}
                                    </div>
                                    <div class="user-menu-intro-stat">
                                        {{ localize('followers', user_stat_data.followers) }}
                                    </div>
                                    <div class="user-menu-intro-stat">
                                        {{ localize('views', user_stat_data.views) }}
                                    </div>
                                </div>
                            </div>
                            <hr>
                        {% for link in header_user_links() %}
                            <a class="menu-item-button" href="{{ link.url }}">{{ link.name }}</a>
                        {% endfor %}
                        <hr>
                        {% for link in header_user_account_links() %}
                            <a class="menu-item-button" href="/login/{{ link.username }}">
                                <div class="menu-item-profile-picture profile-picture">
                                    <img src="{{ profile_picture(link.username) }}" class="pfp"
                                         alt="{{ link.username }}">
                                </div>
                                <span>{{ link.username }}</span>
                            </a>
                        {% endfor %}
                        <a class="menu-item-button small" href="/login"><span>{{ localize('add_account') }}</span></a>
                    </div>
                </div>
            {% else %}
                <div class="user-menu-container">
                    <div class="menu-button user-menu-button" data-menu-id="login-menu">
                        {{ localize('have_an_account') }} {{ localize('login') }}
                        <div class="menu-caret-container">
                            {{ icon("caret-closed", 16, "menu-caret") }}
                        </div>
                    </div>
                    <div class="menu" id="login-menu">
                        <form method="post" name="loginForm" id="loginForm" action="/login" class="form-login">
                            <div class="form-input">
                                <label for="username">{{ localize('username') }}</label>
                                <input type="text" name="username" class="form-submit">
                            </div>

                            <div class="form-input">
                                <label for="password">{{ localize('password') }}</label>
                                <input type="password" name="password" class="form-submit">
                            </div>

                            <div class="login-bottom">
                                <div class="login-text">
                                    {{ localize('dont_have_an_account') }} <a href="/register">{{ localize('register') }}</a>
                                </div>

                                <div class="form-button-container">
                                    <input type="submit" class="button button-primary button-login" value="{{ localize('login') }}" name="loginsubmit">
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
                {#
                {% for link in header_user_links() %}
                    <a class="menulink" href="{{ link.url }}">{{ link.name }}</a>
                {% endfor %}
                #}
            {% endif %}
        </div>
    </div>
</div>
