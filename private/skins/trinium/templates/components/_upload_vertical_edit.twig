{% if upload.type == 0 %}
    {% set icon = "video" %}
{% elseif upload.type == 2 %}
    {% set icon = "image" %}
{% else %}
    {% set icon = "placeholder" %}
{% endif %}

<div class="content-entry">
    <div class="content-thumbnail">
        <a href="/view/{{ upload.id }}">
            <img src="{{ thumbnail(upload.id, upload.type, upload.flags.custom_thumbnail) }}"
                 alt="{{ upload.title }}" class="content-image thumbnail">
        </a>
        <div class="content-thumbnail-badge-container">
            <div class="content-thumbnail-badge">
                {{ icon(icon) }}
            </div>
            {% if upload.type == 0 %}
                <div class="content-thumbnail-badge timestamp">
                    {{ convert_time(upload.length) }}
                </div>
            {% endif %}
        </div>
    </div>
    <div class="content-info">
        <div class="content-title-upload">
            <a href="/view/{{ upload.id }}" class="content-title-link">
                {% if upload.title|trim is not empty %}
                    {{ upload.title }}
                {% else %}
                    No title
                {% endif %}
            </a>
            <div class="content-upload-edit-button">
                <div class="menu-button button secondary button-transparent button-caret"
                     data-menu-id="upload-edit-{{ upload.id }}">
                     {{ icon('three-dots', 16) }}
                </div>
                <div class="menu menu-upload-edit" id="upload-edit-{{ upload.id }}">
                    <a class="menu-item-button" href="/edit?v={{ upload.id }}">
                        <span>{{ localize('edit') }}</span>
                    </a>
                    <a class="menu-item-button" href="/feature?v={{ upload.id }}"
                       onclick="return confirm('{{ localize('feature_on_profile_confirm') }}');">
                        <span>{{ localize('feature_on_profile') }}</span>
                    </a>
                    <a class="menu-item-button" href="/delete?v={{ upload.id }}"
                       onclick="return confirm('{{ localize('delete_upload_confirm') }}');">
                        <span>{{ localize('delete') }}</span>
                    </a>
                </div>
            </div>
        </div>
        <div class="content-description">
            {# {% if upload.description|trim is not empty %}
                <span>{{ upload.description }}</span>
            {% else %}
                <span class="text-faded">No description</span>
            {% endif %}
            <br>#}
            {% if upload.published_originally %}
                Original uploaded: {{ upload.published_originally | format_date('medium', 'medium') }}
                {% if upload.original_site %}on {{ upload.original_site }}{% endif %}
                <br>
            {% endif %}
            Uploaded: {{ upload.published | format_date('medium', 'medium') }}
        </div>
    </div>
</div>