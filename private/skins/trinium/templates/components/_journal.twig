<div class="content-entry journal">
    <div class="content-info">
        <div class="content-title">
            <a href="/user/{{ journal.author.info.username }}/journal/{{ journal.id }}">
                {{ journal.title }}
            </a>
        </div>
        <div class="content-author">{{ user_link(journal.author) }}</div>
        <div class="content-detail">{{ journal.published | relative_time }}</div>
        <div class="content-description clamp">
            {{ journal.contents }}
        </div>
    </div>
</div>