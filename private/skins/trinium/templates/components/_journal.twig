{% if enable_incomplete_features %}
<div class="comment" id="post-{{ journal.id }}">
    <a href="/user/{{ journal.author.info.username }}">
        <div class="profile-picture user-id-{{ journal.author.id }}">
            <img src="{{ profile_picture(journal.author.id) }}" class="pfp" alt="{{ journal.author.info.username }}">
        </div>
    </a>
    <div class="comment-body">
        <div class="comment-author">
            {{ user_link(journal.author) }}
            <span class="comment-timestamp use-tooltip" title="{{ journal.published | format_date('long', 'medium') }}">{{ journal.published | relative_time }}</span>
        </div>
        <div class="comment-contents">
            {% if journal.contents | trim is not empty %}
                {{ journal.contents | markdown_user_written }}
            {% endif %}
        </div>
        <div class="comment-actions">
            <a class="action-button">Action</a>
            <a class="action-button">Action</a>
            <a class="action-button">Action</a>
            <a class="action-button">Action</a>
        </div>
    </div>
</div>
{% else %}
<div class="content-entry journal">
    <div class="content-info">
        <div class="content-title">
            <a href="/read/{{ journal.id }}">
                {{ journal.title }}
            </a>
        </div>
        <div class="content-description">
            {% if data.username != journal.author.info.username %}
                {{ user_link(journal.author) }}
                <br>
            {% endif %}
            {{ journal.published | relative_time }}
            <br>
            {{ journal.contents|u.truncate(300, '...') }}
        </div>
    </div>
</div>
{% endif %}