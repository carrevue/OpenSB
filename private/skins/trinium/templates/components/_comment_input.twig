{% if logged_in %}
<div class="new-post" id="comment_field">
    <div class="profile-picture">
        <img src="{{ profile_picture(user_data.id) }}" class="pfp" alt="{{ user_data.name }}" loading="lazy">
    </div>
    <div id="new-comment-button">
        {{ localize('write_comment') }}
    </div>
    <div id="new-comment-form">
        <textarea id="comment_contents" placeholder="{{ localize('write_comment') }}" name="comment" maxlength="1000" rows="3"></textarea>
        <div class="new-post-bottom">
            <div class="text-danger post-form-error" id="comment-form-error"></div>
            <div class="new-post-buttons">
                <button type="cancel" id="comment_cancel_button" name="cancel" class="button secondary">
                    {{ localize('cancel') }}
                </button>
                <button type="submit" id="comment_post_button" name="post" class="button accent">
                    {{ localize('post_action') }}
                </button>
            </div>
        </div>
    </div>
</div>
{% else %}
<div id="new-comment-button">
    {{ localize('please_login_to_comment') }}
</div>
{% endif %}