<div class="grid">
    <div class="col-9">
        <div class="grid no-gap">
            <div class="col-3">
                <div class="grid-homepage">
                    {#
                    <div class="content-box">
                        <h1>Welcome!</h1>
                        <div class="button button-primary">
                            Button
                        </div>
                    </div>
                    #}
                    <ul class="homepage-list">
                        {% for link in header_main_links() %}
                            <li class="hamburger-link">
                                <a href="{{ link.url }}">{{ link.name }}</a>
                            </li>
                        {% endfor %}
                    </ul>
                    <hr>
                    <ul class="homepage-list">
                        {% for link in sidebar_following_users() %}
                            <li class="hamburger-link">
                                <a href="/user/{{ link.username }}">
                                    <div class="hamburger-link-profile-picture profile-picture">
                                        <img src="{{ profile_picture(link.username) }}" class="pfp" alt="{{ link.username }}">
                                    </div>
                                    {{ link.username }}
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            </div>
            <div class="col-9">
                {% if data.submissions_new %}
                    <div class="section">
                        <div class="section-header flex">
                            <div class="section-header-left">
                                <h2 class="section-title">{{ localize('recent_uploads') }}</h2>
                                <div class="section-desc">{{ localize('recent_uploads_desc') }}</div>
                            </div>
                            <div class="section-header-right">
                                <a href="/browse">{{ localize('more') }}</a>
                            </div>
                        </div>
                        <div class="content-box">
                            {% for submission in data.submissions_new %}
                                {{ include('/components/_upload_vertical.twig') }}
                            {% endfor %}
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
    <div class="col-3">
        {% if data.submissions_featured %}
            <div class="section">
                <div class="section-header flex">
                    <div class="section-header-left">
                        <h2 class="section-title">{{ localize('featured_uploads') }}</h2>
                        <div class="section-desc">{{ localize('featured_uploads_desc') }}</div>
                    </div>
                    <div class="section-header-right">
                        <a href="/browse">{{ localize('more') }}</a>
                    </div>
                </div>
                <div class="content-box">
                    {% for submission in data.submissions_featured %}
                        {{ include('/components/_upload_vertical_small.twig') }}
                    {% endfor %}
                </div>
            </div>
        {% endif %}
        {% if data.news_recent %}
            <div class="section">
                <div class="section-header flex">
                    <div class="section-header-left">
                        <h2 class="section-title">{{ localize('site_news') }}</h2>
                        <div class="section-desc">{{ localize('site_news_desc') }}</div>
                    </div>
                    <div class="section-header-right">
                        <a href="/journals/news">{{ localize('more') }}</a>
                    </div>
                </div>
                <div class="content-box">
                    {% for journal in data.news_recent %}
                        {{ include('/components/_journal.twig') }}
                    {% endfor %}
                </div>
            </div>
        {% endif %}
    </div>
</div>