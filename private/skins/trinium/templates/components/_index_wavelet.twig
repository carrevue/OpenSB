<div class="section">
    <div class="content-box">
        {% if is_user_logged_in %}
        <div class="new-post" id="post_field">
            <div class="profile-picture">
                <img src="{{ profile_picture(user_data.id) }}" class="pfp" alt="{{ user_data.name }}">
            </div>
            <div id="new-post-form">
                <textarea class="form-submit" id="post_contents" placeholder="{{ localize('write_post') }}" name="post" maxlength="1000" rows="3"></textarea>
                <div class="new-post-bottom">
                    <div class="text-danger post-form-error" id="post-form-error">
                        this doesn't work yet
                    </div>
                    <div class="new-post-buttons">
                        <button type="submit" id="post_post_button" name="post" class="button accent">
                            {{ localize('post_action') }}
                        </button>
                    </div>
                </div>
            </div>
        </div>
        {% endif %}
        {% for entry in data.feed %}
            {% if entry.item_type == "post" %}
                {{ include('/components/_post.twig', {post: entry}) }}
            {% elseif entry.item_type == "upload" %}
                {{ include('/components/_upload_vertical.twig', {upload: entry}) }}
            {% else %}
                <div>Unknown feed item with type {{ entry.item_type }}</div>
            {% endif %}
        {% endfor %}
    </div>
</div>