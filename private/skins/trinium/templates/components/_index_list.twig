<div class="grid">
    <div class="col-8">
        {% if data.uploads_following %}
            <div class="section">
                <div class="section-header flex">
                    <div class="section-header-left">
                        <h2 class="section-title">{{ localize('following') }}</h2>
                        <div class="section-desc">{{ localize('following_uploads_desc') }}</div>
                    </div>
                    <div class="section-header-right">
                        <a href="/browse">{{ localize('more') }}</a>
                    </div>
                </div>
                <div class="content-box">
                    {% for upload in data.uploads_following %}
                        {{ include('/components/_upload_vertical.twig') }}
                    {% endfor %}
                </div>
            </div>
        {% elseif data.uploads_featured %}
        <div class="section">
            <div class="section-header flex">
                <div class="section-header-left">
                    <h2 class="section-title">{{ localize('featured_uploads') }}</h2>
                    <div class="section-desc">{{ localize('featured_uploads_desc') }}</div>
                </div>
                <div class="section-header-right">
                    <a href="/browse">{{ localize('more') }}</a>
                </div>
            </div>
            <div class="content-box">
                {% for upload in data.uploads_featured %}
                    {{ include('/components/_upload_vertical.twig') }}
                {% endfor %}
            </div>
            {#<div class="content-box content-grid content-grid-uploads">
                {% for upload in data.uploads_featured %}
                    {{ include('/components/_upload_vertical_home.twig') }}
                {% endfor %}
            </div>#}
        </div>
        {% endif %}
    </div>
    <div class="col-4">
        {% if data.news_recent %}
        <div class="section">
            <div class="section-header flex">
                <div class="section-header-left">
                    <h2 class="section-title">{{ localize('site_news') }}</h2>
                    <div class="section-desc">{{ localize('site_news_desc') }}</div>
                </div>
                <div class="section-header-right">
                    <a href="/journals/news">{{ localize('more') }}</a>
                </div>
            </div>
            <div class="content-box">
                {% for journal in data.news_recent %}
                    {{ include('/components/_journal.twig') }}
                {% endfor %}
            </div>
        </div>
        {% endif %}
        <div class="section">
            <div class="section-header flex">
                <div class="section-header-left">
                    <h2 class="section-title">{{ localize('recent_members') }}</h2>
                    <div class="section-desc">{{ localize('recent_members_desc') }}</div>
                </div>
                <div class="section-header-right">
                    <a href="/users">{{ localize('more') }}</a>
                </div>
            </div>
            <div class="content-box">
                {% for user in data.users_recent %}
                    <div class="content-entry centered index-user user-id-{{ user.id }}">
                        <div class="content-thumbnail">
                            <a href="/user/{{ user.info.username }}">
                                <div class="content-image profile-picture">
                                    <img src="{{ profile_picture(user.id) }}" alt="{{ user.info.username }}" class="pfp">
                                </div>
                            </a>
                        </div>
                        <div class="content-info">
                            <div class="content-title">
                                {{ user_link(user) }}
                            </div>
                            <div class="content-description">
                                <div>
                                    {{ localize('followers', user.followers) }} • {{ localize('upload_count', user.uploads) }}
                                </div>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
</div>