<div class="post" id="comment-{{ comment.id }}">
    <a href="/user/{{ comment.author.info.username }}">
        <div class="profile-picture user-id-{{ comment.author.id }}">
            <img src="{{ profile_picture(comment.author.id) }}" class="pfp" alt="{{ comment.author.info.username }}">
        </div>
    </a>
    <div class="post-body">
        <div class="post-author">
            {% if comment.author.is_owner %}
                <div class="comment-owner">
                    {{ user_link(comment.author) }}
                </div>
            {% else %}
                {{ user_link(comment.author) }}
            {% endif %}
            <span class="post-timestamp use-tooltip" title="{{ comment.posted | format_date('long', 'medium') }}">{{ comment.posted | relative_time }}</span>
        </div>
        <div class="post-contents">
            {% if comment.post | trim is not empty %}
                {{ comment.post | markdown_user_written }}
            {% else %}
                <p><small>Null comment</small></p>
            {% endif %}

            <div class="post-actions">
                {% if comment.id and is_user_logged_in %}
                <a class="action-button reply-button" data-comment-id="{{ comment.id }}">{{ localize('reply_action') }}</a>
                <a class="action-button like-button" data-comment-id="{{ comment.id }}">{{ localize('like') }}</a>
                <a class="action-button dislike-button" data-comment-id="{{ comment.id }}">{{ localize('dislike') }}</a>
                {% endif %}
            </div>

            <div class="replies" id="replies-{{ comment.id }}">
                {% if comment.id and is_user_logged_in %}
                    <div class="reply-form" id="reply-form-{{ comment.id }}" style="display: none;">
                        <div class="profile-picture">
                            <img src="{{ profile_picture(user_data.id) }}" class="pfp" alt="{{ user_data.name }}">
                        </div>
                        <div class="new-reply-form">
                            <textarea class="form-submit" id="reply_contents_{{ comment.id }}" placeholder="{{ localize('write_reply') }}" maxlength="1000" rows="3"></textarea>
                            <div class="new-post-bottom">
                                <div class="text-danger post-form-error" id="reply-form-error-{{ comment.id }}"></div>
                                <div class="new-post-buttons">
                                    <button type="cancel" id="comment_cancel_button" name="cancel" class="button secondary submit-cancel-button">
                                        {{ localize('cancel') }}
                                    </button>
                                    <button type="submit" id="comment_post_button" class="button accent submit-reply-button" data-comment-id="{{ comment.id }}">
                                        {{ localize('reply_action') }}
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endif %}
                {% for reply in comment.replies %}
                    {{ include('/components/_comment.twig', { comment: reply }) }}
                {% endfor %}
            </div>
        </div>
    </div>
</div>