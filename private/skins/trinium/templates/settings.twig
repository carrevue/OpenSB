{% extends "_layout_my_account.twig" %}

{% set title = localize('account_settings') %}

{% set breadcrumbs = [
    { url: '/settings', label: localize('account_settings') },
] %}

{% block my_account_content %}
    {% if error %}
    <div class="banner danger">{{ error }}</div>
    {% endif %}
    <div class="content-box">
        <div class="profile-box">
            <div class="profile-box-pfp">
                <div class="profile-picture">
                    <img src="{{ profile_picture(user_data.id) }}" class="pfp" alt="{{ user_data.name }}">
                </div>
            </div>
            <div class="profile-box-info">
                <div class="profile-box-username">
                    <span style="color:{{ user_data.userlink_color }}" id="settings-display-name">
                        {{ user_data.title }}
                    </span>
                </div>
                <div class="profile-box-handle">
                    @{{ user_data.name }}
                </div>
                <div class="profile-box-handle">
                    {{ user_data.email }}
                </div>
            </div>
        </div>
        <hr>
        <form action="/settings" method="post" enctype="multipart/form-data">
            <div class="section">
                <div class="section-header flex">
                    <div class="section-header-left">
                        <h2 class="section-title">{{ localize('profile') }}</h2>
                        <div class="section-desc">{{ localize('profile_settings_header_desc') }}</div>
                    </div>
                </div>

                <div class="form-input">
                    <label for="title">{{ localize('profile_name') }}</label>
                    <input id="settings-display-name-input" type="text" name="title" maxlength="50" value="{{ user_data.title }}">
                </div>

                <div class="form-input">
                    <label for="about">{{ localize('profile_description') }}</label>
                    <textarea name="about" rows="4">{{ user_data.about }}</textarea>
                </div>

                <div class="form-input">
                    <label for="profilePicture">{{ localize('profile_picture') }} <span>{{ localize('recommended_resolution', "512x512") }}</span></label>
                    <input type="file" name="profilePicture" id="setting-pfp">
                </div>

                <div class="form-input">
                    <label for="profileBanner">{{ localize('profile_banner') }} <span>{{ localize('recommended_resolution', "2500x300") }}</span></label>
                    <input type="file" name="profileBanner" id="settings-banner">
                </div>

                <div class="form-input">
                    <label for="userlink_color">{{ localize('userlink_color') }}</label>
                    <input name="userlink_color" id="settings-color" type="text" data-coloris
                    value="{{ user_data.userlink_color | default('#0069B4') }}">
                </div>
            </div>

            <hr>

            <div class="section">
                <div class="section-header flex">
                    <div class="section-header-left">
                        <h2 class="section-title">{{ localize('profile_customization') }}</h2>
                        <div class="section-desc">{{ localize('profile_customization_desc') }}</div>
                    </div>
                </div>

                <div class="form-input">
                    <input type="checkbox" name="enable_customization" id="enable_customization"
                    value="true" {% if flags.profile_customization_enabled %}checked{% endif %}>
                    <label for="enable_customization">{{ localize('enable_profile_customization') }}</label>
                </div>

                <div class="form-input">
                    <label for="font">Font</label>
                    <select id="font" name="font">
                        {% for key, font in trinium_fonts %}
                            <option value="{{ key }}" {% if profile_color_data.font == key %} selected{% endif %}>{{ font.name }}</option>
                        {% endfor %}
                    </select>
                </div>

                <div class="form-input">
                    <label for="title_color">{{ localize('profile_title_color') }}</label>
                    <input name="title_color" id="settings-title-color" type="text" data-coloris
                    value="{{ profile_color_data.title_color | default('#333333') }}">
                </div>

                <div class="form-input">
                    <label for="link_color">{{ localize('profile_link_color') }}</label>
                    <input name="link_color" id="settings-link-color" type="text" data-coloris
                    value="{{ profile_color_data.link_color | default('#0033cc') }}">
                </div>

                <div class="form-input">
                    <label for="background_color">{{ localize('profile_background_color') }}</label>
                    <input name="background_color" id="settings-background-color" type="text" data-coloris
                    value="{{ profile_color_data.background_color | default('#ffffff') }}">
                </div>

                <div class="form-input">
                    <label for="basic_box_border_color">{{ localize('profile_basic_box_border_color') }}</label>
                    <input name="basic_box_border_color" id="settings-basic-box-border-color" type="text" data-coloris
                    value="{{ profile_color_data.basic_box_border_color | default('#666666') }}">
                </div>

                <div class="form-input">
                    <label for="basic_box_background_color">{{ localize('profile_basic_box_background_color') }}</label>
                    <input name="basic_box_background_color" id="settings-basic-box-background-color" type="text" data-coloris
                    value="{{ profile_color_data.basic_box_background_color | default('#FFFFFF') }}">
                </div>

                <div class="form-input">
                    <label for="basic_box_text_color">{{ localize('profile_basic_box_text_color') }}</label>
                    <input name="basic_box_text_color" id="settings-basic-box-text-color" type="text" data-coloris
                    value="{{ profile_color_data.basic_box_text_color | default('#000000') }}">
                </div>

                <div class="form-input">
                    <label for="highlight_box_border_color">{{ localize('profile_highlight_box_border_color') }}</label>
                    <input name="highlight_box_border_color" id="settings-highlight-box-border-color" type="text" data-coloris
                    value="{{ profile_color_data.highlight_box_border_color | default('#666666') }}">
                </div>

                <div class="form-input">
                    <label for="highlight_box_background_color">{{ localize('profile_highlight_box_background_color') }}</label>
                    <input name="highlight_box_background_color" id="settings-highlight-box-background-color" type="text" data-coloris
                    value="{{ profile_color_data.highlight_box_background_color | default('#E6E6E6') }}">
                </div>

                <div class="form-input">
                    <label for="highlight_box_text_color">{{ localize('profile_highlight_box_text_color') }}</label>
                    <input name="highlight_box_text_color" id="settings-highlight-box-text-color" type="text" data-coloris
                    value="{{ profile_color_data.highlight_box_text_color | default('#000000') }}">
                </div>
            </div>

            <hr>

            <div class="section">
                <div class="section-header flex">
                    <div class="section-header-left">
                        <h2 class="section-title">{{ localize('security') }}</h2>
                        <div class="section-desc">{{ localize('security_desc') }}</div>
                    </div>
                </div>

                <div class="form-input">
                    <label for="current_pass">{{ localize('current_password') }} <span>{{ localize('form_required') }}</span></label>
                    <input type="password" name="current_pass" size="30" maxlength="256">
                </div>

                <hr>

                <div class="section-header">
                    <h3 class="section-title">{{ localize('change_password') }}</h3>
                </div>

                <div class="form-input">
                    <label for="pass">{{ localize('new_password') }}</label>
                    <input type="password" name="pass" size="30" maxlength="256">
                </div>

                <div class="form-input">
                    <label for="pass2">{{ localize('new_password_again') }}</label>
                    <input type="password" name="pass2" size="30" maxlength="256">
                </div>

                <hr>

                <div class="section-header">
                    <h3 class="section-title">{{ localize('change_username') }}</h3>
                </div>

                <div class="form-input">
                    <label for="current_pass">{{ localize('new_username') }}</label>
                    <input type="text" name="new_username" size="30" maxlength="256">
                </div>
            </div>

            <hr>

            <div class="section">
                    <div class="section-header">
                <h2 class="section-title">{{ localize('filtering') }}</h2>
                </div>

                {% if isUserOver18 %}
                    <div>
                        <input type="checkbox" name="rating" id="rating" value="true"
                        {% if flags.mature_content_access %}checked{% endif %}>
                        <label for="rating">{{ localize('enable_sensitive_content') }}</label><br>
                    </div>

                    {#<div>
                        <input type="checkbox" name="rating" id="rating" value="true">
                        <label for="rating"> Block profile/upload access from people under 18</label><br>
                    </div>#}
                {% else %}
                    <div class="text-danger">{{ localize('restricted_sensitive_content', website_branding.name) }}</div>
                {% endif %}

                <div class="form-input">
                <label for="blacklisted_tags">{{ localize('blocked_tags') }}</label>
                    <div>
                        <textarea name="blacklisted_tags" rows="5" cols="80">{% for tag in user_data.blacklisted_tags %}{{ tag }},{% endfor %}</textarea>
                    </div>
                </div>
            </div>
            <hr>
            <div class="form-button-container">
                <input type="submit" id="upload" name="save" class="button accent" value="{{ localize('save_action') }}">
            </div>
        </form>
    </div>
{% endblock %}

{% block scripts %}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/mdbassit/Coloris@latest/dist/coloris.min.css"/>
<script src="https://cdn.jsdelivr.net/gh/mdbassit/Coloris@latest/dist/coloris.min.js"></script>
{% endblock %}