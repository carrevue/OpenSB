{% extends "_layout_my_stuff.twig" %}

{% set title = localize('account_settings') %}

{% block mystuffcontent %}
{% if error %}
<div class="banner banner-danger">{{ error }}</div>
{% endif %}
<div class="section">
    <div class="section-header">
        <h1 class="section-title">{{ localize('account_settings') }}</h1>
    </div>
    <div class="content-box">
        <div class="profile-box">
            <div class="profile-box-pfp">
                <div class="profile-picture">
                    <img src="{{ profile_picture(user_data.name) }}" class="pfp" alt="{{ user_data.name }}">
                </div>
            </div>
            <div class="profile-box-info">
                <div class="profile-box-username">
                    <span style="color:{{ user_data.userlink_color }}" id="settings-display-name">
                        {{ user_data.title }}
                    </span>
                </div>
                <div class="profile-box-handle">
                    @{{ user_data.name }}
                </div>
                <div class="profile-box-handle">
                    {{ user_data.email }}
                </div>
            </div>
        </div>
        <hr>
        <form action="/settings" method="post" enctype="multipart/form-data">
            <div class="section">
                <div class="section-header flex">
                    <div class="section-header-left">
                        <h2 class="section-title">Profile</h2>
                        <div class="section-desc">These will be shown to everyone on your profile.</div>
                    </div>
                </div>

                <div class="form-input">
                    <label for="title">Profile name</label>
                    <input class="form-submit" id="settings-display-name-input" type="text" name="title" maxlength="50" value="{{ user_data.title }}">
                </div>

                <div class="form-input">
                    <label for="about">Profile description</label>
                    <textarea class="form-submit" name="about" rows="4" wrap="hard">{{ user_data.about }}</textarea>
                </div>

                <div class="form-input">
                    <label for="profilePicture">Profile picture <span>Recommended resolution: 512x512</span></label>
                    <input class="form-submit" type="file" name="profilePicture" id="setting-pfp">
                </div>

                <div class="form-input">
                    <label for="profileBanner">Profile banner <span>Recommended resolution: 2500x300</span></label>
                    <input class="form-submit" type="file" name="profileBanner" id="settings-banner">
                </div>

                <div class="form-input">
                    <label for="userlink_color">Username link color</label>
                    <input name="userlink_color" id="settings-color" type="text" data-coloris
                    value="{{ user_data.userlink_color | default('#0069B4') }}">
                </div>
            </div>

            <hr>

            <div class="section">
                <div class="section-header flex">
                    <div class="section-header-left">
                        <h2 class="section-title">Profile customization</h2>
                        <div class="section-desc">Set custom colors on your profile. These will only be shown to anyone using the Trinium skin.</div>
                    </div>
                </div>

                <div class="form-submit">
                    <input type="checkbox" name="enable_customization" id="enable_customization"
                    value="true" {% if flags.profile_customization_enabled %}checked{% endif %}>
                    <label for="enable_customization"> Enable profile customization</label>
                </div>

                <div class="form-input">
                    <label for="font">Font</label>
                    <select class="form-submit" id="font" name="font" class="form-submit">
                        {% for key, font in trinium_fonts %}
                            <option value="{{ key }}" {% if profile_color_data.font == key %} selected{% endif %}>{{ font.name }}</option>
                        {% endfor %}
                    </select>
                </div>

                <div class="form-input">
                    <label for="title_color">Title color</label>
                    <input class="form-submit" name="title_color" id="settings-title-color" type="text" data-coloris
                    value="{{ profile_color_data.title_color | default('#333333') }}">
                </div>

                <div class="form-input">
                    <label for="link_color">Link color</label>
                    <input class="form-submit" name="link_color" id="settings-link-color" type="text" data-coloris
                    value="{{ profile_color_data.link_color | default('#0033cc') }}">
                </div>

                <div class="form-input">
                    <label for="background_color">Background color</label>
                    <input class="form-submit" name="background_color" id="settings-background-color" type="text" data-coloris
                    value="{{ profile_color_data.background_color | default('#ffffff') }}">
                </div>

                <div class="form-input">
                    <label for="basic_box_border_color">Basic box border color</label>
                    <input class="form-submit" name="basic_box_border_color" id="settings-basic-box-border-color" type="text" data-coloris
                    value="{{ profile_color_data.basic_box_border_color | default('#666666') }}">
                </div>

                <div class="form-input">
                    <label for="basic_box_background_color">Basic box background color</label>
                    <input class="form-submit" name="basic_box_background_color" id="settings-basic-box-background-color" type="text" data-coloris
                    value="{{ profile_color_data.basic_box_background_color | default('#FFFFFF') }}">
                </div>

                <div class="form-input">
                    <label for="basic_box_text_color">Basic box text color</label>
                    <input class="form-submit" name="basic_box_text_color" id="settings-basic-box-text-color" type="text" data-coloris
                    value="{{ profile_color_data.basic_box_text_color | default('#000000') }}">
                </div>

                <div class="form-input">
                    <label for="highlight_box_border_color">Highlight box border color</label>
                    <input class="form-submit" name="highlight_box_border_color" id="settings-highlight-box-border-color" type="text" data-coloris
                    value="{{ profile_color_data.highlight_box_border_color | default('#666666') }}">
                </div>

                <div class="form-input">
                    <label for="highlight_box_background_color">Highlight box background color</label>
                    <input class="form-submit" name="highlight_box_background_color" id="settings-highlight-box-background-color" type="text" data-coloris
                    value="{{ profile_color_data.highlight_box_background_color | default('#E6E6E6') }}">
                </div>

                <div class="form-input">
                    <label for="highlight_box_text_color">Highlight box text color</label>
                    <input class="form-submit" name="highlight_box_text_color" id="settings-highlight-box-text-color" type="text" data-coloris
                    value="{{ profile_color_data.highlight_box_text_color | default('#000000') }}">
                </div>
            </div>

            <hr>

            <div class="section">
                <div class="section-header flex">
                    <div class="section-header-left">
                        <h2 class="section-title">Security</h2>
                        <div class="section-desc">Change your username or password here.</div>
                    </div>
                </div>

                <div class="form-input">
                    <label for="current_pass">Current password</label>
                    <input class="form-submit" type="password" name="current_pass" size="30" maxlength="256">
                </div>

                <hr>

                <div class="section-header">
                    <h3 class="section-title">Change password</h3>
                </div>

                <div class="form-input">
                    <label for="pass">New password</label>
                    <input class="form-submit" type="password" name="pass" size="30" maxlength="256">
                </div>

                <div class="form-input">
                    <label for="pass2">Confirm new password</label>
                    <input class="form-submit" type="password" name="pass2" size="30" maxlength="256">
                </div>

                <hr>

                <div class="section-header">
                    <h3 class="section-title">Change username</h3>
                </div>

                <div class="form-input">
                    <label for="current_pass">New username</label>
                    <input class="form-submit" type="text" name="new_username" size="30" maxlength="256">
                </div>
            </div>

            <hr>

            <div class="section">
                    <div class="section-header">
                <h2 class="section-title">Filtering</h2>
                </div>

                {% if not is_chaziz_sb %}
                    {% if isUserOver18 %}
                            <div class="form-submit">
                                <input type="checkbox" name="rating" id="rating" value="true"
                                {% if user_data.comfortable_rating == "mature" %}checked{% endif %}>
                                <label for="rating"> Enable mature-rated content</label><br>
                            </div>

                            {#<div class="form-submit">
                                <input type="checkbox" name="rating" id="rating" value="true">
                                <label for="rating"> Block profile/upload access from people under 18</label><br>
                            </div>#}
                        {% else %}
                            <div class="text-danger">
                                Based on your account's birthdate, access to mature-rated content
                                is restricted. If you have entered an incorrect birthdate,
                                please contact the {{ website_branding.name }} staff team.
                            </div>
                        {% endif %}
                    <br>
                {% endif %}

                <div class="form-input">
                <label for="blacklisted_tags">Blocked tags</label>
                    <div class="form-submit">
                        <textarea class="form-submit" name="blacklisted_tags" rows="5" cols="80" wrap="hard">{% for tag in user_data.blacklisted_tags %}{{ tag }},{% endfor %}</textarea>
                    </div>
                </div>
            </div>
            <hr>
            <div class="form-button-container">
            <input type="submit" id="upload" name="save" class="button button-primary"
            value="Save">
            </div>
        </form>
    </div>
</div>
{% endblock %}

{% block scripts %}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/mdbassit/Coloris@latest/dist/coloris.min.css"/>
<script src="https://cdn.jsdelivr.net/gh/mdbassit/Coloris@latest/dist/coloris.min.js"></script>
{% endblock %}