{% extends "_layout_my_account.twig" %}

{% set title = localize('account_settings') %}

{% set breadcrumbs = [
    { url: '/settings', label: localize('account_settings') },
] %}

{% block my_account_content %}
    {% if error %}
    <div class="alert danger">{{ error }}</div>
    {% endif %}
    <div class="alert accent">Your profile settings have moved. (temporary message)</div>
    <div class="content-box">
        <div class="profile-box">
            <div class="profile-box-pfp">
                <div class="profile-picture">
                    <img src="{{ profile_picture(user_data.id) }}" class="pfp" alt="{{ user_data.name }}">
                </div>
            </div>
            <div class="profile-box-info">
                <div class="profile-box-username">
                    <span style="color:{{ user_data.userlink_color }}" id="settings-display-name">
                        {{ user_data.title }}
                    </span>
                </div>
                <div class="profile-box-handle">
                    @{{ user_data.name }}
                </div>
                <div class="profile-box-handle">
                    {{ user_data.email }}
                </div>
            </div>
        </div>
        <hr>
        <form action="/settings" method="post" enctype="multipart/form-data">
            <div class="section">
                <div class="section-header flex">
                    <div class="section-header-left">
                        <h2 class="section-title">{{ localize('security') }}</h2>
                        <div class="section-desc">{{ localize('security_desc') }}</div>
                    </div>
                </div>

                <div class="form-input">
                    <label for="current_pass">{{ localize('current_password') }} <span>{{ localize('form_required') }}</span></label>
                    <input type="password" name="current_pass" size="30" maxlength="256">
                </div>

                <hr>

                <div class="section-header">
                    <h3 class="section-title">{{ localize('change_password') }}</h3>
                </div>

                <div class="form-input">
                    <label for="pass">{{ localize('new_password') }}</label>
                    <input type="password" name="pass" size="30" maxlength="256">
                </div>

                <div class="form-input">
                    <label for="pass2">{{ localize('new_password_again') }}</label>
                    <input type="password" name="pass2" size="30" maxlength="256">
                </div>

                <hr>

                <div class="section-header">
                    <h3 class="section-title">{{ localize('change_username') }}</h3>
                </div>

                <div class="form-input">
                    <label for="current_pass">{{ localize('new_username') }}</label>
                    <input type="text" name="new_username" size="30" maxlength="256">
                </div>
            </div>

            <hr>

            <div class="section">
                <div class="section-header">
                    <h2 class="section-title">{{ localize('filtering') }}</h2>
                </div>

                {% if mature_uploads_enabled %}
                    {% if isUserOver18 %}
                        <div>
                            <input type="checkbox" name="rating" id="rating" value="true"
                            {% if flags.mature_content_access %}checked{% endif %}>
                            <label for="rating">{{ localize('enable_mature_content') }}</label><br>
                        </div>

                        {#<div>
                            <input type="checkbox" name="rating" id="rating" value="true">
                            <label for="rating"> Block profile/upload access from people under 18</label><br>
                        </div>#}
                    {% else %}
                        <div class="text-danger">{{ localize('restricted_mature_content', website_branding.name) }}</div>
                    {% endif %}
                {% endif %}

                <div class="form-input">
                <label for="blacklisted_tags">{{ localize('blocked_tags') }}</label>
                    <div>
                        <textarea name="blacklisted_tags" rows="5" cols="80">{% for tag in user_data.blacklisted_tags %}{{ tag }},{% endfor %}</textarea>
                    </div>
                </div>
            </div>
            <hr>
            <div class="form-button-container">
                <input type="submit" id="upload" name="save" class="button accent" value="{{ localize('save_action') }}">
            </div>
        </form>
    </div>
{% endblock %}

{% block scripts %}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/mdbassit/Coloris@latest/dist/coloris.min.css"/>
<script src="https://cdn.jsdelivr.net/gh/mdbassit/Coloris@latest/dist/coloris.min.js"></script>
{% endblock %}