{% extends "_layout_login.twig" %}

{% set title = localize('register') %}

{% block scripts %}
    <script src="https://js.hcaptcha.com/1/api.js" async defer></script>
{% endblock %}

	{% block content %}
        <div class="section">
            <div class="section-header">
                <h1 class="section-title">{{ localize('register') }}</h1>
            </div>
            <div class="content-box login">
                <div class="panel-body">
                    <form method="post" name="loginForm" id="loginForm" action="/register" class="form-login">
                        <div class="form-input">
                            <label for="email">{{ localize('email_address') }}</label>
                            <input type="email" name="email" required>
                        </div>

                        <div class="form-input">
                            <label for="username">{{ localize('username') }}</label>
                            <input type="text" name="username" required>
                        </div>

                        <div class="form-input">
                            <label for="pass1">{{ localize('password') }}</label>
                            <input type="password" name="pass1" required>
                        </div>

                        <div class="form-input">
                            <label for="pass2">{{ localize('password_again') }}</label>
                            <input type="password" name="pass2" required>
                        </div>

                        {% if invite_keys_enabled %}
                            <div class="form-input">
                                <label for="invite">{{ localize('invite_key') }}</label>
                                <input type="text" name="invite" required>
                            </div>
                        {% endif %}

                        <div class="form-input">
                            <label for="birthdate">{{ localize('birthdate') }}</label>
                            <input type="date" name="birthdate" required />
                        </div>

                        {% if captcha_public_token %}
                            <div class="form-input">
                                <label>{{ localize('captcha') }}</label>
                                <div class="h-captcha" data-sitekey="{{ captcha_public_token }}"></div>
                            </div>
                        {% endif %}

                        <div class="form-button-container">
                            <input type="submit" class="button accent button-login" value="{{ localize('register') }}" name="registersubmit">
                        </div>

                        <hr>

                        {% if invite_keys_enabled %}
                            <p>
                                {{ localize('register_invite_key_required', website_branding.name) }}
                            </p>
                        {% endif %}
                        <p>
                            {{ localize('register_agreement',  website_branding.name, '/tos', '/privacy') | raw }}
                        </p>
                    </form>
                </div>
            </div>
        </div>
    {% endblock %}
