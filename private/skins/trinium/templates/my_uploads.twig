{% extends "_layout_my_account.twig" %}

{% set title = localize('my_uploads') %}

{% set items_per_page = 20 %}
{% set total_pages = (data.count / items_per_page) | round(0, 'ceil') %}

{% set breadcrumbs = [
    { url: '/my_uploads', label: localize('my_uploads') },
] %}

{% set section_desc = localize('page_num_of_num', page, total_pages) %}

{% block my_account_content %}
    <div class="content-box">
        {% for upload in data.uploads %}
            {{ include('/components/_upload_vertical_edit.twig') }}
        {% endfor %}
    </div>
    {% set le_url = 'my_uploads?page=%s' %}

    {{ pagination(data.count, items_per_page, le_url, page) }}
{% endblock %}