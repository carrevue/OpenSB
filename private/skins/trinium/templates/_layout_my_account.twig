{% extends "_layout.twig" %}

{% block content %}
<div class="section">
    <div class="section-header flex">
        <div class="section-header-left">
            {% if breadcrumbs is defined and breadcrumbs %}
                <nav class="section-header-crumbs">
                    <ol>
                        <li><a href="/my_account">{{ localize('my_account') }}</a></li>
                        {% for crumb in breadcrumbs %}
                            <li>
                                {% if not loop.last %}
                                    <a href="{{ crumb.url }}">{{ crumb.label }}</a>
                                {% else %}
                                    <span>{{ crumb.label }}</span>
                                {% endif %}
                            </li>
                        {% endfor %}
                    </ol>
                </nav>
            {% else %}
                <h1 class="section-title">{{ title }}</h1>
            {% endif %}
            {% if section_desc is defined and section_desc %}
                <div class="section-desc">{{ section_desc }}</div>
            {% endif %}
        </div>
        <div class="section-header-right">
            {% if section_header_right is defined and section_header_right %}
                <a href="{{ section_header_right.url }}">{{ section_header_right.label }}</a>
            {% endif %}
        </div>
    </div>

    {% block my_account_content %}
    {% endblock %}
</div>
{% endblock %}