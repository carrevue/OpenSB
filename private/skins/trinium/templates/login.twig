{% extends "_layout_login.twig" %}

{% set title = localize('login') %}

{% set other_accs = header_user_account_links() %}

	{% block content %}
        <div class="section">
            <div class="section-header">
                <h1 class="section-title">{{ localize('login') }}</h1>
            </div>
            <div class="content-box">
                <div class="grid center">
                    <div class="col-6">
                        <div class="panel-body">
                            <form method="post" name="loginForm" id="loginForm" action="/login" class="form-login">
                                <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                            
                                <div class="form-input">
                                    <label for="username">{{ localize('username') }}</label>
                                    <input type="text" name="username" class="form-submit">
                                </div>

                                <div class="form-input">
                                    <label for="password">{{ localize('password') }}</label>
                                    <input type="password" name="password" class="form-submit">
                                </div>

                                <div class="login-bottom">
                                    <div class="login-text">
                                        {{ localize('dont_have_an_account') }} <a href="/register">{{ localize('register') }}</a>
                                    </div>

                                    <div class="form-button-container">
                                        <input type="submit" class="button button-primary button-login" value="{{ localize('login') }}" name="loginsubmit">
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                    <div class="col-6 col-login-info">
                        {% if is_user_logged_in %}
                            <div class="login-currently-logged-in">
                                <div class="login-pfp">
                                    <div class="profile-picture">
                                        <img src="{{ profile_picture(user_data.name) }}" class="pfp"
                                             alt="{{ user_data.name }}">
                                    </div>
                                </div>
                                <div>
                                    <div class="login-currently-logged-in-text">
                                        {{ localize('currently_logged_in_as', user_data.name) }}
                                    </div>
                                    <div class="login-currently-logged-in-other-accs">
                                        {% if other_accs %}
                                            <span>{{ localize('other_accounts') }}</span>
                                            {% for link in other_accs %}
                                                <a href="/login/{{ link.username }}">{{ link.username }}</a>{{ not loop.last ? ',' }}
                                            {% endfor %}
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                            <hr>
                        {% endif %}
                        <div>
                            <p>{{ localize("login_what_is_site_1", website_branding.name) }}</p>
                            <ul>
                                <li>{{ localize("login_what_is_site_2") }}</li>
                                <li>{{ localize("login_what_is_site_3") }}</li>
                                <li>{{ localize("login_what_is_site_4") }}</li>
                                <li>{{ localize("login_what_is_site_5") }}</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {% endblock %}