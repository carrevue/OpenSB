{% extends "_layout_login.twig" %}

{% set title = localize('login') %}

	{% block content %}
        <div class="section">
            <div class="section-header">
                <h1 class="section-title">{{ localize('login') }}</h1>
            </div>
            <div class="content-box">
                {% if is_user_logged_in %}
                    <div class="login-currently-logged-in">
                        <div class="login-pfp">
                            <div class="profile-picture">
                                <img src="{{ profile_picture(user_data.id) }}" class="pfp"
                                        alt="{{ user_data.name }}">
                            </div>
                        </div>
                        <div>
                            <div class="login-currently-logged-in-text">
                                {{ localize('currently_logged_in_as', user_data.name) }}
                            </div>
                        </div>
                    </div>
                    <hr>
                {% endif %}
                    <div class="panel-body">
                        <form method="post" name="loginForm" id="loginForm" action="/login" class="form-login">
                            <input type="hidden" name="csrf_token" value="{{ session.csrf_token }}">
                        
                            <div class="form-input">
                                <label for="username">{{ localize('username') }}</label>
                                <input type="text" name="username">
                            </div>

                            <div class="form-input">
                                <label for="password">{{ localize('password') }}</label>
                                <input type="password" name="password">
                            </div>

                            <div class="login-bottom">
                                {% if not is_test_instance %}
                                    <div class="login-text">
                                        {{ localize('dont_have_an_account') }} <a href="/register">{{ localize('register') }}</a>
                                    </div>
                                {% endif %}

                                <div class="form-button-container">
                                    <input type="submit" class="button accent button-login" value="{{ localize('login') }}" name="loginsubmit">
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    {% endblock %}