{% extends "_layout_dashboard.twig" %}

{% if search %}
    {% set le_url = '?page=%s&amount=' ~ amount  ~ "&search=" ~ search %}
{% else %}
    {% set le_url = '?page=%s&amount=' ~ amount %}
{% endif %}

{% set title = "IP bans" %}

{% set breadcrumbs = [
    { url: '/dashboard/ip_bans', label: "IP bans" },
] %}

{% block dashboard_content %}
    {% set total_pages = (data.count / amount) | round(0, 'ceil') %}
    {% set current_page = page %}

    <div class="content-box">
        <div class="form-flex">
            <form action="/dashboard/ip/" method="GET" id="num_change" class="admin-form-select">
                <select name="amount" onchange="this.form.submit()">
                    {% for option in [8, 16, 24, 32, 48, 64, 96, 128, 256] %}
                        <option value="{{ option }}" {{ amount == option ? 'selected' }}>{{ option }}</option>
                    {% endfor %}
                </select>
            </form>

            <form method="GET" action="/dashboard/ip/" class="admin-form-search">
                <input type="hidden" name="amount" value="{{ amount }}">
                <input type="text" name="search" value="{{ search }}" placeholder="{{ localize('search') }}...">
                <button type="submit" class="button secondary">
                    {{ icon('search') }}
                </button>
            </form>
        </div>
        <hr>
        {% for ip in ips %}
            <div class="content-entry">
                <div class="content-info">
                    <div class="content-title">
                        {{ ip.ip }}
                    </div>
                    <div class="content-detail">By: {{ ip.author }}</div>
                    <div class="content-detail">Time: {{ ip.timestamp | format_date('long', 'medium') }} ({{ ip.timestamp | relative_time() }})</div>
                    <div class="content-detail">Reason: {{ ip.reason }}</div>
                </div>
            </div>
        {% endfor %}
        {{ pagination(count, amount, le_url, current_page) }}
    </div>
{% endblock %}