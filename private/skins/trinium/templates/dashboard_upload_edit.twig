{% extends "_layout_dashboard.twig" %}

{% set title = "Checking " ~ upload.id %}

{% set breadcrumbs = [
    { url: '/dashboard/uploads', label: "Uploads" },
    { url: '/dashboard/uploads/' ~ upload.id, label: upload.title },
] %}

{% block scripts %}
    <script>
        let takedown_button = (document.getElementById('takedown-button'));
        let takedown_dialog = (document.getElementById('takedown-dialog'));
        let takedown_close_button = (document.getElementById('takedown-close-button'));

        setUpModal(takedown_button, takedown_dialog, takedown_close_button);
    </script>
{% endblock %}

{% block dashboard_content %}
    <div class="content-box">
        <dialog class="content-box report-dialog" id="takedown-dialog">
            <form id="takedownForm" method="post" method="dialog">
                <div class="section">
                    <div class="section-header">
                        <h1 class="section-title">Takedown the upload</h1>
                    </div>
                </div>
                <div class="text-danger">This currently does not notify the author.</div>
                <div class="form-input">
                    <label for="takedown-reason" class="form-label">Reason</label>
                    <textarea id="takedown-reason" name="reason" class="form-submit" rows="6" required></textarea>
                </div>
                <div class="form-button-container">
                    <button class="button secondary" type="cancel" id="takedown-close-button">Close</button>
                    <button class="button accent" name="takedown_submit" type="submit" value="Submit" id="takedown-submit-button">Submit</button>
                </div>
            </form>
        </dialog>
        <div class="section">
            <div class="admin-user-actions">
                {% if upload.takedown %}
                    <form id="takedownForm" method="post" enctype="multipart/form-data">
                        <button name="restore" value="{{ upload.id }}" class="button warning" onclick="if (!confirm('Are you sure you want to restore this upload?')) { return false }">Restore</button>
                    </form>
                {% else %}
                    <div id="takedown-button" class="button danger">Takedown</button>
                {% endif %}
            </div>
        </div>
        <hr>
        <div class="grid">
            <div class="col-6">
                <div class="section">
                    <div class="section-header">
                        <h2 class="section-title">Details</h2>
                    </div>
                    <table class="styled">
                        <tbody>
                        <tr>
                            <td>Title</td>
                            <td>{{ upload.title }}</td>
                        </tr>
                        <tr>
                            <td>Author</td>
                            <td>
                                <a href="/dashboard/users/{{ upload.author.info.username }}">{{ upload.author.info.username }}</a>
                                {% if upload.author.banned %}<span class="text-danger">(Banned)</span>{% endif %}
                            </td>
                        </tr>
                        <tr>
                            <td>Uploaded</td>
                            <td>{{ upload.published | format_date('long', 'medium') }}</td>
                        </tr>
                        {% if upload.takedown %}
                        <tr>
                            <td>Taken down by</td>
                            <td><a href="/dashboard/users/{{ upload.takedown.takedownee }}">{{ upload.takedown.takedownee }}</a></td>
                        </tr>
                        <tr>
                            <td>Time of takedown</td>
                            <td>{{ upload.takedown.time | format_date('long', 'medium') }}</td>
                        </tr>
                        <tr>
                            <td>Reason</td>
                            <td>{{ upload.takedown.reason }}</td>
                        </tr>
                        {% endif %}
                        </tbody>
                    </table>
                </div>
                <hr>
                <div class="section">
                    <div class="section-header">
                        <h2 class="section-title">Ratings</h2>
                    </div>
                    <table class="styled">
                        <tbody>
                            <tr class="table-header">
                                <th>Stars</th>
                                <th>Count</th>
                            </tr>

                            {% for stars, count in upload.interactions.ratings.stars %}
                                <tr>
                                    <td>{{ stars }}</td>
                                    <td>{{ count }}</td>
                                </tr>
                            {% endfor %}

                            <tr>
                                <td><strong>Total</strong></td>
                                <td>{{ upload.interactions.ratings.total }}</td>
                            </tr>
                            <tr>
                                <td><strong>Average</strong></td>
                                <td>{{ upload.interactions.ratings.average }}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="col-6">
                {{ upload_view(upload) }}
                <hr>
                <div class="section">
                    <div class="section-header">
                        <h2 class="section-title">Flags</h2>
                    </div>
                    <form method="post" name="booleanForm" id="booleanForm" action="/dashboard/uploads/{{ upload.id }}">
                        <div class="form-input">
                            <input type="checkbox" id="flag_featured" name="flag_featured"
                                    {% if upload.flags.featured %}checked{% endif %}>
                            <label for="flag_featured"> Featured</label>
                        </div>

                        <div class="form-input">
                            <input type="checkbox" id="flag_unprocessed" name="flag_unprocessed"
                                    {% if upload.flags.unprocessed %}checked{% endif %}>
                            <label for="flag_unprocessed"> Unprocessed video</label>
                        </div>

                        <div class="form-input">
                            <input type="checkbox" id="flag_block_guests" name="flag_block_guests"
                                    {% if upload.flags.block_guests %}checked{% endif %}>
                            <label for="flag_block_guests"> Block guests</label>
                        </div>

                        <div class="form-input">
                            <input type="checkbox" id="flag_block_comments" name="flag_block_comments"
                                    {% if upload.flags.block_comments %}checked{% endif %}>
                            <label for="flag_block_comments"> Block comments</label>
                        </div>

                        <div class="form-input">
                            <input type="checkbox" id="flag_custom_thumbnail" name="flag_custom_thumbnail"
                                    {% if upload.flags.custom_thumbnail %}checked{% endif %}>
                            <label for="flag_custom_thumbnail"> Custom thumbnail</label>
                        </div>

                        <div class="form-input">
                            <input type="checkbox" id="flag_mature" name="flag_mature"
                                    {% if upload.flags.mature %}checked{% endif %}>
                            <label for="flag_mature"> Mature</label>
                        </div>

                        <div class="form-button-container">
                            <input type="submit" class="button accent" value="{{ localize('save_action') }}" name="flagsubmit">
                        </div>
                    </form>
                </div>
                <hr>
                <div class="section">
                    <div class="section-header">
                        <h2 class="section-title">Upload processor log</h2>
                    </div>
                    {% if upload.log %}
                        <pre>
                        {{- upload.log -}}
                    </pre>
                    {% else %}
                        No logs could be found.
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}