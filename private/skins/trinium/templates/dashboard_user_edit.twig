{% extends "_layout_dashboard.twig" %}

{% set title = user.name %}

	{% block admincontent %}
        <div class="section">
            <div class="admin-user-actions">
                <form id="banForm" method="post" enctype="multipart/form-data">
                    {% if user.powerlevel <= 1 %}
                        {% if user.is_banned %}
                            <button name="ban_user" value="{{ user.name }}" class="button button-warning" onclick="if (!confirm('Are you sure you want to unban this user?')) { return false }">Unban</button>
                        {% else %}
                            <button name="ban_user" value="{{ user.name }}" class="button button-danger" onclick="if (!confirm('Are you sure you want to ban this user?')) { return false }">Ban</button>
                        {% endif %}
                        {# <div name="ban_user" class="button button-danger" onclick="alert('Not implemented')">IP Ban</div> #}
                        {% if not flags.unverified %}
                            <button name="verify_user" value="{{ user.name }}" class="button button-secondary" onclick="if (!confirm('Are you sure you want to unverify this user?')) { return false }">Unverify</button>
                        {% else %}
                            <button name="verify_user" value="{{ user.name }}" class="button button-success" onclick="if (!confirm('Are you sure you want to verify this user?')) { return false }">Verify</button>
                        {% endif %}
                    {% else %}
                        This space intentionally left blank.
                    {% endif %}
                </form>
            </div>
        </div>
        <hr>
        <div class="grid">
            <div class="col-6">
                <div class="section">
                    <div class="content-box">
                        <div class="section-header">
                            <h2 class="section-title">Details</h2>
                        </div>
                        <table class="c1">
                            <tbody>
                            <tr>
                                <td>{{ localize('user_id') }}</td>
                                <td>{{ user.id }}</td>
                            </tr>
                            <tr>
                                <td>{{ localize('username') }}</td>
                                <td>{{ user.name }}</td>
                            </tr>
                            <tr>
                                <td>{{ localize('profile_name') }}</td>
                                <td>{{ user.name }}</td>
                            </tr>
                            {% if user_data.powerlevel > 2 %}
                                <tr>
                                    <td>IP address</td>
                                    <td>{{ user.ip }}</td>
                                <tr>
                            {% endif %}
                            <tr>
                                <td>{{ localize('user_role') }}</td>
                                <td>
                                    {% set role = 
                                        user.powerlevel == 1 ? localize('user_role_normal') :
                                        user.powerlevel == 2 ? localize('user_role_moderator') :
                                        user.powerlevel == 3 ? localize('user_role_administrator') :
                                        user.powerlevel == 4 ? localize('user_role_owner') :
                                        localize('user_role_unknown') ~ ' (' ~ user.powerlevel ~ ')'
                                    %}
                                    {{ role }}
                                </td>
                            </tr>
                            <tr>
                                <td>{{ localize('age') }}/{{ localize('birth_date') }}</td>
                                <td>{{ user.birthdate | calculate_age }} / {{ user.birthdate | format_date('long', 'none') }}</td>
                            </tr>
                            <tr>
                                <td>{{ localize('registered') }}</td>
                                <td>{{ user.joined | format_date('long', 'medium') }}
                                    <br>({{ user.birthdate | calculate_age_from(user.joined) }} years old)
                                    {% if flags.fulptube_account %}
                                    <br><small>{{ localize('fulptube_account') }}</small>
                                    {% endif %}
                                </td>
                            </tr>
                            <tr>
                                <td>{{ localize('last_seen') }}</td>
                                <td>{{ user.lastview | format_date('long', 'medium') }}</td>
                            </tr>
                            {% if not is_chaziz_sb %}
                            <tr>
                                <td>{{ localize('comfortable_rating') }}</td>
                                <td>{{ user.comfortable_rating }}</td>
                            </tr>
                            {% endif %}
                            <tr>
                                <td>{{ localize('user_link_color') }}</td>
                                <td style="background:{{ user.customcolor }};"></td>
                            </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                {% if ip_info %}
                    <div class="section">
                        <div class="content-box">
                            <div class="section-header">
                                <h2 class="section-title">IP info</h2>
                            </div>
                            <table class="c1">
                                <tbody>
                                {% for key, info in ip_info %}
                                    <tr>
                                        <td>
                                            {{ localize(key) }}
                                        </td>
                                        <td>
                                            {{ info }}
                                        </td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                {% endif %}
                {% if users_with_matching_ips %}
                    <div class="section">
                        <div class="content-box">
                            <div class="section-header">
                                <h2 class="section-title">Other accounts with matching IP</h2>
                            </div>
                            <table class="c1">
                                <tbody>
                                {% for user in users_with_matching_ips %}
                                    <tr>
                                        <td>
                                            <a href="/dashboard/users/{{ user.name }}">{{ user.name }}</a>
                                        </td>
                                        <td>
                                            {{ user.title }}
                                        </td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                {% endif %}
                {% if old_names %}
                    <div class="section">
                        <div class="content-box">
                            <div class="section-header">
                                <h2 class="section-title">Previous usernames</h2>
                            </div>
                            <table class="c1">
                                <tbody>
                                {% for entry in old_names %}
                                    <tr>
                                        <td>
                                            {{ entry.old_name }}
                                        </td>
                                        <td>
                                            {{ entry.time | format_date('long', 'medium') }}
                                        </td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                {% endif %}
            </div>
            <div class="col-6">
                <div class="section">
                    <div class="content-box">
                        <div class="section-header">
                            <h2 class="section-title">Assets</h2>
                        </div>
                        <table class="c1">
                            <tbody>
                            <tr class="h">
                                <th style="width:50%;">Profile picture</th>
                                <th style="width:50%;">Banner</th>
                            </tr>
                            <tr>
                                <td>
                                    <img src="{{ profile_picture(user.name) }}" style="width:100%;" alt="{{ user.username }}">
                                </td>
                                <td>
                                    <img src="{{ profile_banner(user.name) }}" style="width:100%;" alt="{{ user.username }}">
                                </td>
                            </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                {% if notes %}
                <div class="section">
                    <div class="content-box">
                        <div class="section-header">
                            <h2 class="section-title">Notes</h2>
                        </div>
                        {% for note in notes %}
                            <div class="content-box content-note">
                                <div>
                                    By {{ user_link(note.author) }}, {{ note.time | relative_time }}
                                </div>
                                {{ note.content | markdown_user_written(true) }}
                            </div>
                        {% endfor %}
                    </div>
                </div>
                {% endif %}
            </div>
        </div>
    {% endblock %}