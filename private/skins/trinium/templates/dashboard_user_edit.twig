{% extends "_layout_dashboard.twig" %}

{% set title = user.name %}

{% set breadcrumbs = [
    { url: '/dashboard/users', label: "Users" },
    { url: '/dashboard/users/' ~ user.name, label: user.name },
] %}

{% block dashboard_content %}
    <div class="content-box">
        <div class="section">
            <div class="admin-user-actions">
                <form id="banForm" method="post" enctype="multipart/form-data">
                    {% for key, button in buttons %}
                        {% if button.condition %}
                            {% for state in button.states %}
                                {% if state.condition %}
                                    <button
                                        name="{{ state.name }}"
                                        value="{{ state.value }}"
                                        class="{{ state.class }}"
                                        onclick="if (!confirm('{{ state.confirm }}')) { return false }"
                                    >{{ state.label }}</button>
                                {% endif %}
                            {% endfor %}
                        {% endif %}
                    {% endfor %}
                </form>
            </div>
        </div>
        <hr>
        <div class="grid">
            <div class="col-6">
                <div class="section">
                    <div class="section-header">
                        <h2 class="section-title">Details</h2>
                    </div>
                    <table class="styled">
                        <tbody>
                            {% for row in user_info_table %}
                                {% if row.condition %}
                                    <tr>
                                        <td>{{ row.label }}</td>
                                        <td {% if row.style is defined %}style="{{ row.style }}"{% endif %}>
                                            {% if row.raw_html is defined and row.raw_html %}
                                                {{ row.value | raw }}
                                            {% else %}
                                                {{ row.value }}
                                            {% endif %}
                                        </td>
                                    </tr>
                                {% endif %}
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                {% if ip_info %}
                    <hr>
                    <div class="section">
                        <div class="section-header">
                            <h2 class="section-title">IP info</h2>
                        </div>
                        <table class="styled">
                            <tbody>
                            {% for key, info in ip_info %}
                                <tr>
                                    <td>
                                        {{ localize(key) }}
                                    </td>
                                    <td>
                                        {{ info }}
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}
                {% if users_with_matching_ips %}
                    <hr>
                    <div class="section">
                        <div class="section-header">
                            <h2 class="section-title">Accounts with matching IP</h2>
                        </div>
                        <table class="styled">
                            <tbody>
                            {% for user in users_with_matching_ips %}
                                <tr>
                                    <td>
                                        <a href="/dashboard/users/{{ user.name }}">{{ user.name }}</a>
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}
                {% if old_names %}
                    <hr>
                    {# username history (entries with timestamp) #}
                    <div class="section">
                        <div class="section-header">
                            <h2 class="section-title">Username history</h2>
                        </div>
                        <table class="styled">
                            <tbody>
                                {% for entry in old_names
                                    |filter(e => e.timestamp != 0 and e.timestamp != 1)
                                    |sort((a, b) => b.timestamp <=> a.timestamp)
                                %}
                                    <tr>
                                        <td>{{ entry.old_name }}</td>
                                        <td>{{ entry.timestamp | format_date('long', 'medium') }}</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    <hr>
                    {# aliases (entries with no timestamp) #}
                    <div class="section">
                        <div class="section-header">
                            <h2 class="section-title">Aliases</h2>
                        </div>
                        <table class="styled">
                            <tbody>
                                {% for entry in old_names
                                    |filter(e => e.timestamp == 0 or e.timestamp == 1)
                                %}
                                    <tr>
                                        <td>{{ entry.old_name }}</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}
            </div>
            <div class="col-6">
                <div class="section">
                    <div class="section-header">
                        <h2 class="section-title">Assets</h2>
                    </div>
                    <table class="styled">
                        <tbody>
                        <tr class="table-header">
                            <th style="width:25%;">Profile picture</th>
                            <th style="width:75%;">Banner</th>
                        </tr>
                        <tr>
                            <td>
                                <img src="{{ profile_picture(user.id) }}" style="width:100%;" alt="{{ user.username }}">
                            </td>
                            <td>
                                <img src="{{ profile_banner(user.id) }}" style="width:100%;" alt="{{ user.username }}">
                            </td>
                        </tr>
                        </tbody>
                    </table>
                </div>
                {% if notes %}
                <hr>
                <div class="section">
                    <div class="section-header">
                        <h2 class="section-title">Notes</h2>
                    </div>
                    {% for note in notes %}
                        <div class="content-box">
                            <div class="content-info">
                                <div class="content-title">
                                    {{ user_link(note.author) }}
                                    {{ note.time | relative_time }}
                                </div>
                            </div>
                            <div class="content-detail">
                                {{ note.content | markdown_user_written(true) }}
                            </div>
                        </div>
                    {% endfor %}
                </div>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}