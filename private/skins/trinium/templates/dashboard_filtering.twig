{% extends "_layout_dashboard.twig" %}

{% set title = "Filtering" %}

{% set breadcrumbs = [
    { url: '/dashboard/filtering', label: "Filtering" },
] %}

{% block dashboard_content %}
    <div class="content-box">
        <div class="section">
            <div class="section-header">
                <h2>Blocked usernames</h2>
            </div>
            <table class="styled">
                <tr class="table-header">
                    <th>Name</th>
                </tr>
                {% for entry in data %}
                    <tr>
                        <td class="a">{{ entry.name }}</td>
                    </tr>
                {% endfor %}
            </table>
        </div>
    </div>
{% endblock %}