{% extends "_layout_dashboard.twig" %}

{% set title = "Invite keys" %}

	{% block dashboard_content %}
        <div class="inviteKeyGenerationForm">
        <form name="inviteKeyGenerationForm" id="inviteKeyGenerationForm" method="post"
              action="/dashboard/invite_keys" enctype="multipart/form-data">
            <input type="hidden" id="action" name="action" value="generate_invite_key"/>
            <input class="button primary huge" type="submit" id="generate" name="generate"
                   value="Generate invite key">
        </form>
        </div>
        <hr>
        <div class="section">
            <div class="section-header">
                <h1 class="section-title">All invite keys</h1>
            </div>
            <table class="styled">
                <tr class="table-header">
                    <th>Invite key</th>
                    <th>Generated by</th>
                    <th>Claimed by</th>
                </tr>
                {% for inviteKey in data.invites %}
                    <tr style="height: 30px;">
                        <td>
                            <code>{{ inviteKey.invite_key }}</code>
                        </td>
                        <td>
                            {{ inviteKey.generated_by.name }}
                            <small>({{ inviteKey.generated_time | format_date('long', 'none') }}
                                / {{ inviteKey.generated_time | relative_time }})</small>
                        </td>
                        <td>
                            {% if inviteKey.claimed_by %}
                                {{ inviteKey.claimed_by.name }}
                                <small>({{ inviteKey.claimed_time | format_date('long', 'none') }}
                                    / {{ inviteKey.claimed_time | relative_time }})</small>
                            {% else %}
                                Unclaimed
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </table>
        </div>
    {% endblock %}