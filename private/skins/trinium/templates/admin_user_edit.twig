{% extends "_layout_admin.twig" %}

{% set title = user.name %}

	{% block admincontent %}
        <div class="grid">
            <div class="col-6">
                <div class="section">
                    <div class="content-box">
                        <div class="section-header">
                            <h2 class="section-title">Details</h2>
                        </div>
                        <table class="c1">
                            <tbody>
                            <tr>
                                <td>Username</td>
                                <td>{{ user.name }}</td>
                            </tr>
                            <tr>
                                <td>Profile name</td>
                                <td>{{ user.name }}</td>
                            </tr>
                            <tr>
                                <td>IP address</td>
                                <td>
                                    {{ user.ip }}
                                </td>
                            <tr>
                            <tr>
                                <td>Role</td>
                                <td>
                                    {% set role = 
                                        user.powerlevel == 1 ? 'User' :
                                        user.powerlevel == 2 ? 'Moderator' :
                                        user.powerlevel == 3 ? 'Administrator' :
                                        user.powerlevel == 4 ? 'Owner' :
                                        'Unknown (' ~ user.powerlevel ~ ')'
                                    %}
                                    {{ role }}
                                </td>
                            </tr>
                            <tr>
                                <td>Age/Birthday</td>
                                <td>{{ user.birthdate | calculate_age }} / {{ user.birthdate | localize_date('long', 'none') }}</td>
                            </tr>
                            <tr>
                                <td>Registered</td>
                                <td>{{ user.joined | localize_date('long', 'medium') }}
                                    <br>({{ user.birthdate | calculate_age_from(user.joined) }} years old)
                                    {% if flags.fulptube_account %}<br><small>FulpTube account</small>{% endif %}
                                </td>
                            </tr>
                            <tr>
                                <td>Last seen</td>
                                <td>{{ user.lastview | localize_date('long', 'medium') }}</td>
                            </tr>
                            {% if not is_chaziz_sb %}
                            <tr>
                                <td>Comfortable rating</td>
                                <td>{{ user.comfortable_rating }}</td>
                            </tr>
                            {% endif %}
                            <tr>
                                <td>User link color</td>
                                <td style="background:{{ user.customcolor }};"></td>
                            </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                {% if users_with_matching_ips %}
                    <div class="section">
                        <div class="content-box">
                            <div class="section-header">
                                <h2 class="section-title">Other accounts with matching IP</h2>
                            </div>
                            <table class="c1">
                                <tbody>
                                {% for user in users_with_matching_ips %}
                                    <tr>
                                        <td>
                                            <a href="/admin/users/{{ user.name }}">{{ user.name }}</a>
                                        </td>
                                        <td>
                                            {{ user.title }}
                                        </td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                {% endif %}
                {% if old_names %}
                    <div class="section">
                        <div class="content-box">
                            <div class="section-header">
                                <h2 class="section-title">Previous usernames</h2>
                            </div>
                            <table class="c1">
                                <tbody>
                                {% for entry in old_names %}
                                    <tr>
                                        <td>
                                            {{ entry.old_name }}
                                        </td>
                                        <td>
                                            {{ entry.time | localize_date('long', 'medium') }}
                                        </td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                {% endif %}
            </div>
            <div class="col-6">
                <div class="section">
                    <div class="content-box">
                        <div class="section-header">
                            <h2 class="section-title">Assets</h2>
                        </div>
                        <table class="c1">
                            <tbody>
                            <tr class="h">
                                <th style="width:50%;">Profile picture</th>
                                <th style="width:50%;">Banner</th>
                            </tr>
                            <tr>
                                <td>
                                    <img src="{{ profile_picture(user.name) }}" style="width:100%;" alt="{{ user.username }}">
                                </td>
                                <td>
                                    <img src="{{ profile_banner(user.name) }}" style="width:100%;" alt="{{ user.username }}">
                                </td>
                            </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                {% if notes %}
                <div class="section">
                    <div class="content-box">
                        <div class="section-header">
                            <h2 class="section-title">Notes</h2>
                        </div>
                        {% for note in notes %}
                            <div class="content-box content-note">
                                <div>
                                    By {{ user_link(note.author) }}, {{ note.time | relative_time }}
                                </div>
                                {{ note.content | markdown_user_written(true) }}
                            </div>
                        {% endfor %}
                    </div>
                </div>
                {% endif %}
            </div>
        </div>
    {% endblock %}