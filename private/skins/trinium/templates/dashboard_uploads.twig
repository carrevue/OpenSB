{% extends "_layout_dashboard.twig" %}

{% if search %}
    {% set le_url = '?page=%s&amount=' ~ amount  ~ "&search=" ~ search %}
{% else %}
    {% set le_url = '?page=%s&amount=' ~ amount %}
{% endif %}

{% set title = "Uploads" %}

	{% block admincontent %}
        {% set total_pages = (data.count / amount) | round(0, 'ceil') %}
        {% set current_page = page %}

        <div class="form-flex">
            <form action="/dashboard/uploads/" method="GET" id="num_change" class="admin-form-select">
                <select name="amount" onchange="this.form.submit()">
                    {% for option in [8, 16, 24, 32, 48, 64, 96, 128, 256] %}
                        <option value="{{ option }}" {{ amount == option ? 'selected' }}>{{ option }}</option>
                    {% endfor %}
                </select>
            </form>

            <form method="GET" action="/dashboard/uploads/" class="admin-form-search">
                <input type="hidden" name="amount" value="{{ amount }}">
                <input type="text" name="search" value="{{ search }}" placeholder="{{ localize('search') }}...">
                <button type="submit" class="button button-secondary">
                    <div class="biscuit-icon search"></div>
                </button>
            </form>
        </div>
        <hr>
        <div class="banner banner-secondary">
            For the time being, ban someone if they first upload something that breaks the rules.
        </div>
        <hr>
        {% for upload in uploads %}
            <div class="content-entry">
                <div class="content-thumbnail">
                    <img src="{{ thumbnail(upload.id, upload.type, true) }}" alt="{{ upload.title }}" class="content-image thumbnail">
                </div>
                <div class="content-thumbnail">
                    <img src="{{ thumbnail(upload.id, upload.type, false) }}" alt="{{ upload.title }}" class="content-image thumbnail">
                </div>
                <div class="content-info">
                    <div class="content-title">
                        {{ upload.title }}
                    </div>
                    <div class="content-description">
                        <div>
                            Uploader: <a href="/dashboard/users/{{ upload.author.info.username }}">{{ upload.author.info.username }}</a>
                        </div>
                        <div>
                            Uploaded: {{ upload.published | format_date('long', 'medium') }} ({{ upload.published | relative_time }})</a>
                        </div>
                        {% if upload.status %}
                        <div>
                            Status: <span class="text-{{ upload.status.color }}">{{ upload.status.text }}</span>
                        </div>
                        {% endif %}
                    </div>
                    <div>
                        <a class="button button-secondary button-small" href="/dashboard/uploads/{{ upload.id }}">
                            Manage
                        </a>
                    </div>
                </div>
            </div>
        {% endfor %}

        {{ pagination(count, amount, le_url, current_page) }}
    {% endblock %}