{% extends "_layout_profile.twig" %}

{% set title = data.username ~ "'s uploads" %}

{% set opengraph_type = "profile" %}
{% set opengraph_username = data.username %}
{% if data.about | trim is not empty %}
    {% set opengraph_description = data.about %}
{% else %}
    {% set opengraph_description = "This user has not set a description." %}
{% endif %}
{% set opengraph_image = profile_picture(data.username) %}

{% block content %}
    {% set total_pages = (data.count / items_per_page) | round(0, 'ceil') %}
    {% set current_page = page %}

    <div class="section">
        <div class="section-header flex">
            <div class="section-header-left">
                <h1 class="section-title">{{ title }}</h1>
                <div class="section-desc">{{ localize('page_num_of_num', current_page, total_pages )}}</div>
            </div>
        </div>
        {% if not user %}
            <div class="tabs">
                <a class="tablink {% if type=='recent' %}active{% endif %}" href="/user/{{data.username}}/uploads?type=recent">
                    {{ localize('new') }}
                </a>
                <a class="tablink {% if type=='popular' %}active{% endif %}"href="/user/{{data.username}}/uploads?type=popular">
                    {{ localize('popular') }}
                </a>
            </div>
        {% endif %}
        <div class="content-box basic-box no-border-top">
            {% for submission in data.submissions %}
                {{ include('/components/_upload_vertical.twig') }}
            {% endfor %}
        </div>

        {% if type == 'recent' %}
            {% set le_url = 'user/' ~ data.username ~ '?page=%s' %}
        {% else %}
            {% set le_url = 'user/' ~ data.username ~ '?type=' ~ type ~ '&page=%s' %}
        {% endif %}

        {{ pagination(data.count, items_per_page, le_url, current_page) }}
    </div>
{% endblock %}