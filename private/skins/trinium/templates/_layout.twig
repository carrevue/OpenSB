{% set logo_suffix = current_theme starts with 'dark' ? '-dark' : '' %}
{% set logo_extension = website_branding.is_vector ? '.svg' : '.png' %}
{% set logo_type = website_branding.use_wordmark ? 'logo-wordmark' : 'logo' %}

{% set logo = website_branding.assets_location ~ '/' ~ logo_type ~ logo_suffix ~ logo_extension %}

<!DOCTYPE html>
<html lang="{{ language_code }}" dir="ltr">
<head>
    {{ include('/components/_html_head.twig') }}
    <link rel="stylesheet" href="/assets/css/trinium-{{ current_theme }}.css?r={{ get_css_file_date() }}">

    {% if opengraph_type %}
        <meta property="og:type" content="{{ opengraph_type }}" />
    {% else %}
        <meta property="og:type" content="website" />
    {% endif %}

    {% if opengraph_type == "profile" %}
        <meta property="profile:username"
              content="{{ opengraph_username }}" />
    {% endif %}

    {% if opengraph_description %}
        <meta property="og:description"
              content="{{ opengraph_description }}" />
        <meta name="description" content="{{ opengraph_description }}">
    {% endif %}

    {% if opengraph_image %}
        <meta property="og:image" content="{{ opengraph_image }}">
    {% else %}
        <meta property="og:image" content="{{ website_branding.assets_location }}/logo_square_icon.png">
    {% endif %}

    {% if opengraph_author %}
        <meta property="article:author" content="{{ opengraph_author }}" />
    {% endif %}
    {% if metadata_author %}
        <meta name="author" content="{{ metadata_author }}">
    {% endif %}

    {% if opengraph_section %}
        <meta property="article:section" content="{{ opengraph_section }}" />
    {% endif %}

    {% if opengraph_published %}
        <meta property="article:published_time" content="{{ opengraph_published }}" />
    {% endif %}

    <style>
        {# this is done through twig because css does not support string addition or whatever the FUCK its called.
            -chaziz 2025-08-03 #}
        :root {
            {% if current_theme starts with 'dark' %}
            --jumbotron: url('{{ website_branding.assets_location }}/jumbotron_background_dark.jpg');
            {% else %}
            --jumbotron: url('{{ website_branding.assets_location }}/jumbotron_background.jpg');
            {% endif %}
        }
    </style>

    {% if is_user_logged_in and options.trinium_link_coloring %}
        <style>
            :root {
                --link-color: {{ user_data.userlink_color }};
            }
        </style>
    {% endif %}

    {% set user_data_cache = get_user_data_cache() %}

    {% if user_data_cache and not data.customization %}
        <style>
            {% for user in user_data_cache %}
            .content-entry.user-id-{{ user.id }} .content-thumbnail a .content-image.profile-picture:hover {
                border-color: {{ user.userlink_color }};
            }
            {% endfor %}
        </style>
    {% endif %}

    {% block style %}
    {% endblock %}
</head>
{# somewhat hacky #}
<svg width="0" height="0" style="position:absolute">
    <defs>
        <mask id="stars-mask" maskUnits="objectBoundingBox" maskContentUnits="userSpaceOnUse">
            <g fill="white">
                <use href="/assets/icons.svg#star" x="0" y="0" width="16" height="16" />
                <use href="/assets/icons.svg#star" x="16" y="0" width="16" height="16" />
                <use href="/assets/icons.svg#star" x="32" y="0" width="16" height="16" />
                <use href="/assets/icons.svg#star" x="48" y="0" width="16" height="16" />
                <use href="/assets/icons.svg#star" x="64" y="0" width="16" height="16" />
            </g>
        </mask>
    </defs>
</svg>
<body {% if is_goanna %}class="goanna"{% endif %}>
{% if is_debug %}
    {% include('components/debug_dialog.twig') %}
{% endif %}
{{ include(component('header')) }}
{% if user_ban_data %}
    <div class="banner banner-danger full-screen">
        {{ notification_icon('danger') }}
        <span class="banner-text">
        You have been banned from {{ website_branding.name }}.
        </span>
    </div>
{% endif %}
{% if show_warning_banner %}
    <div class="banner banner-danger full-screen">
    <span class="banner-text">
    {{ warning_banner_text | raw }}
    </span>
    </div>
{% endif %}
{% block precontent %}{% endblock %}
<div class="page {% if data.customization %}customized-profile{% endif %}">
    <div class="page-contents">
        <div class="container {{ page_name }} {% if banner_picture %}has-profile-banner{% endif %}">
            {#{% if not show_sidebar %}
                {% block content %}{% endblock %}
                {{ include(component('footer')) }}
            {% else %}#}
            <div class="sidebar-page-grid">
                <div class="sidebar-container {% if options.trinium_show_sidebar %}active{% endif %}" id="sidebar">
                    <div class="sidebar
                        {% if page_name == "home" %}with-jumbotron{% endif %}
                        {% if data.customization %}user-custom-profile{% endif %}">
                        {% include('components/_hamburger_menu.twig') %}
                    </div>
                </div>
                <div class="content">
                    {{ include(component('banners')) }}
                    {% block content %}{% endblock %}
                    {{ include(component('footer')) }}
                </div>
            </div>
            {#{% endif %}#}
        </div>
    </div>
</div>
<script>
    opensb_version = '{{ opensb_version.name }} {{ opensb_version.string }}';
</script>
{% block scripts %}{% endblock %}
{# yes #}
<script src="/assets/common_shared.js?r={{ get_css_file_date() }}"></script>
<script src="/assets/common_trinium.js?r={{ get_css_file_date() }}"></script>
<!-- {{ version_banner() }} -->
</body>
</html>