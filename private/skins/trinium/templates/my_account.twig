{% extends "_layout_my_account.twig" %}

{% set title = localize('my_account') %}

{% block my_account_content %}
    <div class="content-box">
        <div class="profile-box">
            <div class="profile-box-pfp">
                <div class="profile-picture">
                    <img src="{{ profile_picture(user_data.id) }}" class="pfp" alt="{{ user_data.name }}">
                </div>
            </div>
            <div class="profile-box-info">
                <div class="profile-box-username">
                    <span style="color:{{ user_data.userlink_color }}" id="settings-display-name">
                        {{ user_data.title }}
                    </span>
                </div>
                <div class="profile-box-handle">
                    @{{ user_data.name }}
                </div>
                <div class="profile-box-handle">
                    {{ user_data.email }}
                </div>
            </div>
        </div>
        <hr>
        <ul>
            <li><a href="/my_uploads">{{ localize('uploads') }}</a></li>
            {% if enable_incomplete_features %}
            <li><a href="/my_messages">{{ localize('messages') }}</a></li>
            {% endif %}
            <li><a href="/my_invite_keys">{{ localize('invite_keys') }}</a></li>
            {#<li><a href="/notifications">{{ localize('notifications') }}</a></li>#}
            <li><a href="/settings">{{ localize('account_settings') }}</a></li>
        </ul>
    </div>
{% endblock %}