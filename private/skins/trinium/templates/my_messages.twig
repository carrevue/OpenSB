{% extends "_layout_my_account.twig" %}

{% set title = "My messages" %}

{% block my_account_content %}
    <div class="content-box">
        <div>
            <div>none of these do anything yet</div>
            <a class="button secondary small">Archive</a>
            <a class="button secondary small">Report Spam</a>
            <a class="button secondary small">Delete</a>
        </div>
        <table class="styled">
            <tbody>
                <tr class="table-header">
                    <th></th>
                    <th>From</th>
                    <th>Subject</th>
                    <th>Date</th>
                </tr>
                {% for message in data %}
                <tr>
                    <td width="24px"><input type="checkbox"></td>
                    <td width="240px">{{ user_link(message.author) }}</td>
                    <td>{{ message.title }}</td>
                    <td width="150px" align="right">
                        <span class="use-tooltip" title="{{ message.published | format_date('long', 'none') }}">{{ message.published | relative_time }}</span>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}