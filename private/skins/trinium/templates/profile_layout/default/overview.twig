<div class="content-box no-border-bottom-rounded">
    <div class="profile-box">
        <div class="profile-box-pfp">
            <div class="profile-picture">
                <img src="{{ profile_picture(common.id) }}" class="pfp" alt="{{ common.username }}">
            </div>
        </div>
        <div class="profile-box-info">
            <div class="profile-box-username">
                <span>@{{ common.username }}</span>
                {% if common.is_staff %}
                    <span class="profile-box-icon use-tooltip" title="{{ localize('staff') }}">{{ icon('staff') }}</span>
                {% endif %}
            </div>
            <div class="profile-box-details">
                <span id="follower_count">{{ common.followers }}</span> followers
            </div>
        </div>
        <div class="profile-box-follow">
            {% if is_user_logged_in %}
                {% if not common.is_current %}
                    <button class="button secondary small" id="follow-user">
                        {% if common.following %}
                            {{ localize('unfollow') }}
                        {% else %}
                            {{ localize('follow') }}
                        {% endif %}
                    </button>
                {% else %}
                    {% if enable_incomplete_features and options.exp_trinium_profile_settings %}
                        <button class="button secondary small" id="edit-profile">{{ localize('edit') }}</button>
                    {% else %}
                        <a href="/my_profile">{{ localize('edit') }}</a>
                    {% endif %}
                {% endif %}
            {% endif %}
        </div>
    </div>
</div>
<div class="grid cluster">
    <div class="col-3">
        <div class="content-box">
            {% if data.about | trim is not empty %}
                <div class="profile-about">
                    {{ common.about | markdown_user_written }}
                    <hr>
                </div>
            {% endif %}
            <div class="profile-details">
                <ul class="profile-details-list">
                    <li class="detail-item">
                        <span class="detail-label">{{ localize('registered') }}:</span>
                        <span class="detail-value">{{ common.joined | format_date('long', 'none') }}</span>
                    </li>
                    {% if common.last_active %}
                        <li class="detail-item">
                            <span class="detail-label">{{ localize('last_active') }}:</span>
                            <span class="detail-value">{{ common.last_active | relative_time() }}</span>
                        </li>
                    {% endif %}
                </ul>
                {% if user_is_authenticated_staff %}
                    <hr>
                    <a href="/dashboard/users/{{ common.username }}">{{ localize('dashboard_lookup') }}</a>
                {% endif %}
            </div>
        </div>
    </div>
    <div class="col-9">
        <div class="tab-group">
            <div class="tabs">
                {# spaceless removes html whitespace that causes unnecessary margins #}
                {% apply spaceless %}
                    <div class="tablink" data-tab="tab_uploads">{{ localize('uploads') }}</div>
                    <div class="tablink" data-tab="tab_designtest2">{{ localize('posts') }}</div>
                {% endapply %}
            </div>
            <div class="content-box no-border-top">
                <div id="tab_uploads" class="tabcontent">
                    <div class="section">
                        <div class="content-box">
                            <div class="section-header flex">
                                <div class="section-header-left">
                                    <h2 class="section-title">{{ localize('uploads') }}</h2>
                                </div>
                                <div class="section-header-right">
                                    <a href="/user/{{ common.username }}/uploads">{{ localize('more') }}</a>
                                </div>
                            </div>
                            <div class="content-grid">
                                {% for upload in data.uploads %}
                                    {{ include('/components/_upload_grid.twig') }}
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                </div>
                <div id="tab_designtest2" class="tabcontent">
                    {% if data.journals %}
                        <div class="section">
                            <div class="content-box">
                                <div class="section-header flex">
                                    <div class="section-header-left">
                                        <h2 class="section-title">{{ localize('posts') }}</h2>
                                    </div>
                                    <div class="section-header-right">
                                        <a href="/user/{{ common.username }}/posts">{{ localize('more') }}</a>
                                    </div>
                                </div>
                                {% for journal in data.journals %}
                                    {{ include('/components/_journal.twig') }}
                                {% endfor %}
                            </div>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>