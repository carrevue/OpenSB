{% extends "_layout.twig" %}
{% set show_sidebar = false %}

{% block content %}
<div class="tabs">
    {% for tab_key, tab in page.tabs %}
        <a class="tablink" href="#{{ tab_key }}">
            {{ tab.name }}
        </a>
    {% endfor %}
</div>

<div class="content-box no-border-top">
    {% for section in page.sections %}
        <div class="section">
            <div class="section-header">
                <h1 class="section-title">{{ section.title }}</h1>
            </div>

            <div class="box-contents">
                {% for key, item in section.contents %}
                    {% if key == 'buttons' %}
                        <div class="button-group">
                            {% for button in item %}
                                <button class="button button-{{ button.color }}">
                                    {{ button.text }}
                                </button>
                            {% endfor %}
                        </div>
                    {% elseif key == 'list' %}
                        <ul>
                            {% for k, v in item %}
                                <li>{{ k }}: {{ v }}</li>
                            {% endfor %}
                        </ul>
                    {% elseif item.text is defined %}
                        {% if item.raw is defined and item.raw %}
                            {{ item.text|raw }}
                        {% else %}
                            <p>{{ item.text }}</p>
                        {% endif %}
                    {% endif %}
                {% endfor %}
            </div>
        </div>

        {% if not loop.last %}
            <hr>
        {% endif %}
    {% endfor %}
</div>
{% endblock %}