{
    "require": {
        "ext-pdo": "*",
        "ext-intl": "*",
        "ext-curl": "*",
        "ext-xml": "*",
        "twig/twig": "3.28.0",
        "intervention/image": "3.11.7",
        "erusev/parsedown": "dev-master",
        "php-ffmpeg/php-ffmpeg": "1.4.0",
        "twig/string-extra": "3.24.0",
        "jaybizzle/crawler-detect": "1.4.0",
        "nopjmp/discord-webhooks": "0.4.2",
        "maxmind-db/reader": "1.13.1",
        "wikimedia/composer-merge-plugin": "^2.1",
        "phpmailer/phpmailer": "7.1.1"
    },
    "minimum-stability": "stable",
    "config": {
        "platform": {
            "php": "8.2"
        },
        "allow-plugins": {
            "wikimedia/composer-merge-plugin": true
        }
    },
    "autoload": {
        "psr-4": {
            "OpenSB\\": "private/"
        }
    },
    "require-dev": {
        "arokettu/pseudolocale": "^1.1"
    },
    "extra": {
        "merge-plugin": {
            "include": [
                "composer.local.json",
                "private/skins/*/composer.json"
            ],
            "recurse": true,
            "replace": false,
            "ignore-duplicates": false,
            "merge-dev": true,
            "merge-extra": false,
            "merge-extra-deep": false,
            "merge-replace": true,
            "merge-scripts": false
        }
    }
}
